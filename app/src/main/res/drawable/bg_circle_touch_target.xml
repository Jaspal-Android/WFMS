<?xml version="1.0" encoding="utf-8"?>
<!-- A 24dp filled circle centred in a 48dp touch target (the minimum recommended tap size). -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/ic_circular_bg"
    android:insetBottom="@dimen/icon_touch_inset"
    android:insetLeft="@dimen/icon_touch_inset"
    android:insetRight="@dimen/icon_touch_inset"
    android:insetTop="@dimen/icon_touch_inset" />
