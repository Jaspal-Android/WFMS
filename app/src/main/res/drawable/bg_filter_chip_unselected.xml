<?xml version="1.0" encoding="utf-8"?>
<!-- Unselected filter chip, outlined: a pill inset so it draws 36dp inside the 48dp touch target. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetTop="@dimen/chip_touch_inset" android:insetBottom="@dimen/chip_touch_inset">
    <shape android:shape="rectangle">
        <corners android:radius="@dimen/radius_pill" />
        <solid android:color="?attr/wfmsColorSurface" />
        <stroke android:width="@dimen/border_width_1dp" android:color="?attr/wfmsColorOutline" />
    </shape>
</inset>
