<?xml version="1.0" encoding="utf-8"?>
<!-- Add Site: Client → Project → Circle (each unlocks the next), then the site's fields. -->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <import type="android.view.View" />

        <variable
            name="vm"
            type="com.atvantiq.wfms.ui.screens.admin.ui.site.addSite.AddSiteVM" />
    </data>

    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/wfmsColorBackground"
        android:fitsSystemWindows="true"
        android:orientation="vertical"
        tools:context=".ui.screens.admin.ui.site.addSite.AddSiteActivity">

        <include
            android:id="@+id/addSiteToolbar"
            layout="@layout/custom_toolbar" />

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:focusableInTouchMode="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/padding">

                <!-- Client → Project → Circle -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="?attr/wfmsColorSurface"
                    app:cardCornerRadius="@dimen/card_radius"
                    app:cardElevation="0dp"
                    app:strokeColor="?attr/wfmsColorOutline"
                    app:strokeWidth="@dimen/border_width_1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingHorizontal="@dimen/padding"
                        android:paddingBottom="@dimen/padding">

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/CustomOutlinedField.Picker"
                            android:hint="@string/client"
                            app:placeholderText="@string/not_selected">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/client_et"
                                style="@style/CustomSelectableTextInputEditStyle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:enabled="@{!vm.isClientLoading}"
                                android:padding="@dimen/padding"
                                android:singleLine="true"
                                android:text="@{vm.clientName}" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/CustomOutlinedField.Picker"
                            android:enabled="@{vm.clientName != null &amp;&amp; !vm.isProjectLoading}"
                            android:hint="@string/project"
                            app:placeholderText="@string/not_selected">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/project_et"
                                style="@style/CustomSelectableTextInputEditStyle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:enabled="@{vm.clientName != null &amp;&amp; !vm.isProjectLoading}"
                                android:padding="@dimen/padding"
                                android:singleLine="true"
                                android:text="@{vm.projectName}" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/CustomOutlinedField.Picker"
                            android:enabled="@{vm.projectName != null &amp;&amp; !vm.isCircleLoading}"
                            android:hint="@string/circle"
                            app:placeholderText="@string/not_selected">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/circle_et"
                                style="@style/CustomSelectableTextInputEditStyle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:enabled="@{vm.projectName != null &amp;&amp; !vm.isCircleLoading}"
                                android:padding="@dimen/padding"
                                android:singleLine="true"
                                android:text="@{vm.circleName}" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Site fields -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin"
                    app:cardBackgroundColor="?attr/wfmsColorSurface"
                    app:cardCornerRadius="@dimen/card_radius"
                    app:cardElevation="0dp"
                    app:strokeColor="?attr/wfmsColorOutline"
                    app:strokeWidth="@dimen/border_width_1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingHorizontal="@dimen/padding"
                        android:paddingBottom="@dimen/padding">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/site_id_layout"
                            style="@style/CustomOutlinedField"
                            android:hint="@string/site_id_label">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/site_id_et"
                                style="@style/CustomEditInputTextRegularStyle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:imeOptions="actionNext"
                                android:inputType="textCapCharacters"
                                android:singleLine="true"
                                android:text="@={vm.siteId}" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/site_name_layout"
                            style="@style/CustomOutlinedField"
                            android:hint="@string/site_name_label">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/site_name_et"
                                style="@style/CustomEditInputTextRegularStyle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:imeOptions="actionNext"
                                android:inputType="textCapWords"
                                android:singleLine="true"
                                android:text="@={vm.siteName}" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/site_address_layout"
                            style="@style/CustomOutlinedField"
                            android:hint="@string/site_address_label">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/site_address_et"
                                style="@style/CustomEditInputTextRegularStyle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:imeOptions="actionNext"
                                android:inputType="textPostalAddress"
                                android:singleLine="true"
                                android:text="@={vm.siteAddress}" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/CustomOutlinedField"
                            android:hint="@string/latitude_optional">

                            <com.google.android.material.textfield.TextInputEditText
                                style="@style/CustomEditInputTextRegularStyle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:imeOptions="actionNext"
                                android:inputType="numberDecimal|numberSigned"
                                android:singleLine="true"
                                android:text="@={vm.siteLatitude}" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/CustomOutlinedField"
                            android:hint="@string/longitude_optional">

                            <com.google.android.material.textfield.TextInputEditText
                                style="@style/CustomEditInputTextRegularStyle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:imeOptions="actionDone"
                                android:inputType="numberDecimal|numberSigned"
                                android:singleLine="true"
                                android:text="@={vm.siteLongitude}" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.atvantiq.wfms.widgets.GradientButton
                    style="@style/CustomButtonStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin"
                    android:layout_marginBottom="@dimen/margin"
                    android:enabled="@{vm.canCreate}"
                    android:onClick="@{() -> vm.onSaveClick()}"
                    android:text="@string/create_site"
                    android:textColor="@color/white"
                    android:textStyle="bold" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
</layout>
