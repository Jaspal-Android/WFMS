<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <import type="android.view.View" />
        <variable name="siteStatusInteger" type="Integer" />
        <variable name="isOpenAssignment" type="Boolean" />
        <variable name="isAcceptedAssignment" type="Boolean" />
        <variable name="showEndAssignment" type="Boolean" />
        <variable name="showSelectAll" type="Boolean" />
        <variable name="hideButtons" type="Boolean" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/wfmsColorBackground">

        <!-- ══════════════════════════════════════
             GRADIENT HEADER
             Gradient applied in code via applyToolbarGradient()
             same pattern as DashboardActivity
        ══════════════════════════════════════ -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Back button -->
            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="@dimen/padding"
                android:src="@drawable/arrow_back_ios_24"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                 />

            <!-- Back label -->
            <TextView
                android:id="@+id/tvBack"
                style="@style/CustomRegularTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/back"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="@+id/btnBack"
                app:layout_constraintStart_toEndOf="@id/btnBack"
                app:layout_constraintTop_toTopOf="@id/btnBack" />

            <!-- Site name -->
            <TextView
                android:id="@+id/tvSiteName"
                style="@style/CustomLargeTextView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin"
                android:layout_marginTop="@dimen/margin_small"
                android:layout_marginEnd="@dimen/margin"
                android:layout_marginBottom="@dimen/margin_small"
                android:text="Chandigarh site"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/btnBack" />

            <!-- Site code subtitle -->
            <TextView
                android:id="@+id/tvSiteCode"
                style="@style/CustomSmallTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin"
                android:layout_marginBottom="@dimen/margin"
                android:alpha="0.75"
                android:text="CHD-345-POWN-234"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvSiteName" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- ══════════════════════════════════════
             SCROLLABLE CONTENT
        ══════════════════════════════════════ -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/scrollContent"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:fillViewport="true"
            app:layout_constraintBottom_toTopOf="@id/layoutActions"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layoutHeader">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/padding">

                <!-- ── Site Information card ── -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardSiteInfo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="?attr/wfmsColorSurface"
                    app:cardCornerRadius="@dimen/card_radius_max"
                    app:cardElevation="@dimen/elevation_small"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="@dimen/padding">

                        <!-- Site Information title -->
                        <TextView
                            android:id="@+id/tvInfoTitle"
                            style="@style/CustomRegularTextView"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/margin_small"
                            android:text="@string/site_information"
                            android:textColor="?attr/wfmsColorPrimary"
                            android:textStyle="bold"
                            app:layout_constraintEnd_toStartOf="@+id/tvStatus"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <!-- Status chip — binding adapter sets bg + text color -->
                        <TextView
                            android:id="@+id/tvStatus"
                            style="@style/CustomSmallTextView"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/status_primary_bg"
                            android:paddingHorizontal="@dimen/padding"
                            android:paddingVertical="@dimen/padding_x_small"
                            android:textStyle="bold"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="@+id/tvInfoTitle"
                            assignedSiteStatus="@{siteStatusInteger}"
                            tools:text="OPEN"
                            tools:textColor="@color/status_present_text" />

                        <!-- Divider -->
                        <View
                            android:id="@+id/dividerInfo"
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_marginTop="@dimen/margin_small"
                            android:alpha="0.1"
                            android:background="?attr/wfmsColorOnSurface"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/tvInfoTitle" />

                        <!-- 2x2 Info grid -->
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/infoGrid"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/margin_small"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/dividerInfo">

                            <!-- Project chip -->
                            <LinearLayout
                                android:id="@+id/chipProject"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="@dimen/margin_small_extra"
                                android:background="@drawable/info_chip_bg"
                                android:elevation="@dimen/elevation_small"
                                android:orientation="vertical"
                                android:paddingStart="@dimen/padding_small"
                                android:paddingTop="@dimen/padding_x_small"
                                android:paddingEnd="@dimen/padding_small"
                                android:paddingBottom="@dimen/padding_x_small"
                                app:layout_constraintEnd_toStartOf="@+id/chipCircle"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent">

                                <TextView
                                    style="@style/CustomSmallTextView"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/project"
                                    android:textAllCaps="true"
                                    android:textColor="?attr/wfmsColorOnSurfaceVariant"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tvProject"
                                    style="@style/CustomSmallTextView"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="ERRICSON-TOWER-110"
                                    android:textColor="?attr/wfmsColorOnSurface"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <!-- Circle chip -->
                            <LinearLayout
                                android:layout_marginStart="@dimen/margin_small_extra"
                                android:id="@+id/chipCircle"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:background="@drawable/info_chip_bg"
                                android:elevation="@dimen/elevation_small"
                                android:orientation="vertical"
                                android:paddingStart="@dimen/padding_small"
                                android:paddingTop="@dimen/padding_x_small"
                                android:paddingEnd="@dimen/padding_small"
                                android:paddingBottom="@dimen/padding_x_small"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toEndOf="@+id/chipProject"
                                app:layout_constraintTop_toTopOf="parent">

                                <TextView
                                    style="@style/CustomSmallTextView"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/circle"
                                    android:textAllCaps="true"
                                    android:textColor="?attr/wfmsColorOnSurfaceVariant"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tvCircle"
                                    style="@style/CustomSmallTextView"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Haryana (HR)"
                                    android:textColor="?attr/wfmsColorOnSurface"
                                    android:textStyle="bold" />
                            </LinearLayout>

                        </androidx.constraintlayout.widget.ConstraintLayout>

                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.cardview.widget.CardView>

                <!-- ── Work Types heading row ── -->
                <TextView
                    android:id="@+id/tvWorkTitle"
                    style="@style/CustomRegularTextView"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin"
                    android:text="@string/work_types"
                    android:textColor="?attr/wfmsColorOnSurface"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/cardSiteInfo" />

                <!-- Select All checkbox row -->
                <CheckBox
                    android:id="@+id/cbSelectAllWorkTypes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_small"
                    app:buttonTint="?attr/wfmsColorPrimary"
                    android:visibility="@{showSelectAll ? View.VISIBLE : View.GONE}"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvWorkTitle" />

                <TextView
                    style="@style/CustomRegularTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/select_all"
                    android:textColor="?attr/wfmsColorOnSurface"
                    android:visibility="@{showSelectAll ? View.VISIBLE : View.GONE}"
                    app:layout_constraintBottom_toBottomOf="@+id/cbSelectAllWorkTypes"
                    app:layout_constraintStart_toEndOf="@+id/cbSelectAllWorkTypes"
                    app:layout_constraintTop_toTopOf="@+id/cbSelectAllWorkTypes" />

                <!-- Work types RecyclerView -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvWorkTypes"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_small"
                    android:nestedScrollingEnabled="false"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/cbSelectAllWorkTypes"
                    tools:itemCount="3"
                    tools:listitem="@layout/item_work_type" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- ══════════════════════════════════════
             BOTTOM ACTION BUTTONS
        ══════════════════════════════════════ -->
        <LinearLayout
            android:id="@+id/layoutActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/wfmsColorSurface"
            android:elevation="@dimen/elevation"
            android:orientation="vertical"
            android:paddingTop="@dimen/padding_small"
            android:paddingBottom="@dimen/padding_small"
            android:visibility="@{hideButtons ? View.GONE : View.VISIBLE}"
            app:layout_constraintBottom_toBottomOf="parent">

            <!-- Accept — gradient button -->
            <com.atvantiq.wfms.widgets.GradientButton
                android:id="@+id/btnAccept"
                style="@style/CustomButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin"
                android:layout_marginTop="@dimen/margin_small"
                android:layout_marginEnd="@dimen/margin"
                android:text="@string/accept"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:visibility="@{isOpenAssignment ? View.VISIBLE : View.GONE}" />

            <!-- Start Site — gradient button -->
            <com.atvantiq.wfms.widgets.GradientButton
                android:id="@+id/btnStartWork"
                style="@style/CustomButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin"
                android:layout_marginTop="@dimen/margin_small"
                android:layout_marginEnd="@dimen/margin"
                android:text="@string/start_site"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:visibility="@{isAcceptedAssignment ? View.VISIBLE : View.GONE}" />

            <!-- End Work — error outline button -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnEndWork"
                style="@style/CustomButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin"
                android:layout_marginTop="@dimen/margin_small"
                android:layout_marginEnd="@dimen/margin"
                android:layout_marginBottom="@dimen/margin_small"
                android:background="@drawable/cancel_bt_bg"
                android:text="@string/end_work"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:visibility="@{showEndAssignment ? View.VISIBLE : View.GONE}" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>