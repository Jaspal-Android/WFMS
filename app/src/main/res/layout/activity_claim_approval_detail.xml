<?xml version="1.0" encoding="utf-8"?>
<!-- Claim Approval (spec 8.2): header with claim amount / live approval total / date tiles, Basic
     Information, a card per site with an approved amount per expense, and the submit bar (or why
     this role can't act). -->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <import type="android.view.View" />

        <variable
            name="claim"
            type="com.atvantiq.wfms.models.reimbursement.detail.ClaimData" />

        <variable
            name="claimIdLabel"
            type="String" />

        <variable
            name="amount"
            type="String" />

        <variable
            name="approvalTotal"
            type="String" />

        <variable
            name="dateLabel"
            type="String" />

        <variable
            name="category"
            type="String" />

        <variable
            name="purpose"
            type="String" />

        <variable
            name="route"
            type="String" />

        <variable
            name="canAct"
            type="Boolean" />

        <variable
            name="reviewed"
            type="Boolean" />
    </data>

    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/wfmsColorBackground"
        android:fitsSystemWindows="true"
        android:orientation="vertical"
        tools:context=".ui.screens.admin.ui.claimApproval.ClaimApprovalDetailActivity">

        <include
            android:id="@+id/toolbar"
            layout="@layout/custom_toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/margin"
                android:paddingTop="@dimen/margin_small"
                android:paddingBottom="@dimen/margin"
                android:visibility="@{claim == null ? View.INVISIBLE : View.VISIBLE}">

                <!-- Header: name, status, claim id, then claim amount | approval total | date -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="?attr/wfmsColorSurface"
                    app:cardCornerRadius="@dimen/card_radius"
                    app:cardElevation="0dp"
                    app:strokeColor="?attr/wfmsColorOutline"
                    app:strokeWidth="@dimen/border_width_1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/padding">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    style="@style/CustomLargeTextView"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@{claim.employee.employeeName}"
                                    android:textColor="?attr/wfmsColorOnSurface"
                                    android:textStyle="bold"
                                    tools:text="Kunal Paswan" />

                                <TextView
                                    style="@style/CustomRegularTextView"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@{claimIdLabel}"
                                    android:textColor="?attr/wfmsColorOnSurfaceVariant"
                                    tools:text="Claim ID: 191509550675" />
                            </LinearLayout>

                            <TextView
                                style="@style/CustomStatusChip"
                                android:layout_marginTop="0dp"
                                android:layout_marginEnd="0dp"
                                android:layout_marginStart="@dimen/margin_small"
                                app:claimStatus="@{claim.status}"
                                tools:text="@string/submitted" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/border_width_1dp"
                            android:layout_marginVertical="@dimen/margin_medium"
                            android:background="?attr/wfmsColorOutline" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <LinearLayout style="@style/CustomFactTile">

                                <TextView
                                    style="@style/CustomFactTileLabel"
                                    android:text="@string/claim_amount" />

                                <TextView
                                    style="@style/CustomFactColumnValue"
                                    android:text="@{amount}"
                                    tools:text="₹ 200.00" />
                            </LinearLayout>

                            <LinearLayout
                                style="@style/CustomFactTile"
                                android:layout_marginHorizontal="@dimen/margin_small"
                                android:background="@drawable/bg_fact_tile_positive">

                                <TextView
                                    style="@style/CustomFactTileLabel"
                                    android:text="@string/approval_total"
                                    android:textColor="@color/status_present_text" />

                                <TextView
                                    style="@style/CustomFactColumnValue"
                                    android:text="@{approvalTotal}"
                                    android:textColor="@color/status_present_text"
                                    tools:text="₹ 200.00" />
                            </LinearLayout>

                            <LinearLayout style="@style/CustomFactTile">

                                <TextView
                                    style="@style/CustomFactTileLabel"
                                    android:text="@string/date" />

                                <TextView
                                    style="@style/CustomFactColumnValue"
                                    android:text="@{dateLabel}"
                                    tools:text="1 Oct 2026" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Basic Information -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_medium"
                    app:cardBackgroundColor="?attr/wfmsColorSurface"
                    app:cardCornerRadius="@dimen/card_radius"
                    app:cardElevation="0dp"
                    app:strokeColor="?attr/wfmsColorOutline"
                    app:strokeWidth="@dimen/border_width_1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/padding">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="@dimen/icon_size_small"
                                android:layout_height="@dimen/icon_size_small"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_description"
                                app:tint="?attr/wfmsColorOnSurface" />

                            <TextView
                                style="@style/CustomLargeTextView"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/margin_small"
                                android:text="@string/basic_information"
                                android:textColor="?attr/wfmsColorOnSurface"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/margin_small"
                            android:orientation="horizontal">

                            <TextView
                                style="@style/CustomFactLabel"
                                android:text="@string/category" />

                            <TextView
                                style="@style/CustomFactValue"
                                android:text="@{category}"
                                tools:text="local" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/margin_small"
                            android:orientation="horizontal">

                            <TextView
                                style="@style/CustomFactLabel"
                                android:text="@string/purpose" />

                            <TextView
                                style="@style/CustomFactValue"
                                android:text="@{purpose}"
                                tools:text="Unknown" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/margin_small"
                            android:orientation="horizontal">

                            <TextView
                                style="@style/CustomFactLabel"
                                android:text="@string/travel_route" />

                            <TextView
                                style="@style/CustomFactValue"
                                android:text="@{route}"
                                tools:text="ATQ OFFICE to BALONGI" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    style="@style/CustomSectionCaption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin"
                    android:layout_marginBottom="0dp"
                    android:text="@string/expense_decision" />

                <TextView
                    style="@style/CustomMoreRowSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_small_extra"
                    android:text="@string/expense_decision_help" />

                <LinearLayout
                    android:id="@+id/sitesContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- Bottom bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/wfmsColorSurface"
            android:orientation="vertical"
            android:padding="@dimen/padding"
            android:visibility="@{claim == null ? View.GONE : View.VISIBLE}">

            <com.atvantiq.wfms.widgets.GradientButton
                android:id="@+id/btnSubmit"
                style="@style/CustomButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:enabled="@{!safeUnbox(reviewed)}"
                android:text="@{safeUnbox(reviewed) ? @string/claim_reviewed : @string/submit_claim_approval}"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:visibility="@{safeUnbox(canAct) || safeUnbox(reviewed) ? View.VISIBLE : View.GONE}" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="@{safeUnbox(canAct) || safeUnbox(reviewed) ? View.GONE : View.VISIBLE}">

                <ImageView
                    android:layout_width="@dimen/icon_size_small"
                    android:layout_height="@dimen/icon_size_small"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_lock"
                    app:tint="?attr/wfmsColorOnSurfaceVariant" />

                <TextView
                    style="@style/CustomRegularTextView"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_small"
                    android:layout_weight="1"
                    android:text="@string/claim_decision_not_permitted"
                    android:textColor="?attr/wfmsColorOnSurfaceVariant" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</layout>
