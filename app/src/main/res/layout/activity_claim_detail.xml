<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">
    <data>
        <variable
            name="viewModel"
            type="com.atvantiq.wfms.ui.screens.reimbursement.ReimbursementViewModel" />

        <variable
            name="claim"
            type="com.atvantiq.wfms.models.reimbursement.detail.ClaimData" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/cardLightBackground">

        <!-- Header Section -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/headerLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="@dimen/margin_small_extra"
            app:layout_constraintTop_toTopOf="parent">

            <include
                android:id="@+id/claimDetailsToolbar"
                layout="@layout/custom_toolbar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <androidx.cardview.widget.CardView
                android:id="@+id/cardTotalAmount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/margin"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="@dimen/card_radius"
                app:cardElevation="0dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/claimDetailsToolbar">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/padding">

                    <TextView
                        app:layout_constraintTop_toTopOf="parent"
                        android:id="@+id/tvStatus"
                        style="@style/CustomSmallTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/status_primary_bg"
                        android:paddingHorizontal="@dimen/padding_small"
                        android:paddingVertical="@dimen/padding_x_small"
                        android:text="@{claim.status}"
                        android:textColor="@color/colorPrimaryDark"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toEndOf="parent"
                        tools:text="Submitted" />

                    <!-- Amount -->
                    <LinearLayout
                        app:layout_constraintTop_toBottomOf="@+id/tvStatus"
                        android:layout_marginTop="@dimen/margin_medium"
                        android:id="@+id/amountContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="2">

                        <!-- Claim Amount Box -->
                        <LinearLayout
                            android:paddingVertical="@dimen/padding_small"
                            android:paddingHorizontal="@dimen/padding_medium"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="@dimen/margin_small"
                            android:background="@drawable/bg_approval_pending"
                            android:orientation="vertical">

                            <TextView
                                android:textStyle="bold"
                                android:textAllCaps="true"
                                style="@style/CustomSmallTextView"
                                android:text="@string/claim_amount"
                                android:id="@+id/claimAmountLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>

                            <TextView
                                android:textColor="@color/colorPrimaryDark"
                                android:layout_marginTop="@dimen/margin_2dp"
                                android:text="@{@string/rupee_format(claim.totalAmount != null ? claim.totalAmount : 0.0)}"
                                android:id="@+id/tvAmount"
                                style="@style/CustomLargeDarkTextView"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textStyle="bold"
                                tools:text="350.00" />
                        </LinearLayout>

                        <!-- Approved Amount Box -->
                        <LinearLayout
                            android:layout_marginStart="@dimen/margin_small"
                            android:paddingVertical="@dimen/padding_small"
                            android:paddingHorizontal="@dimen/padding_medium"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/bg_approval_approved"
                            android:orientation="vertical">

                            <TextView
                                style="@style/CustomSmallTextView"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="APPROVED AMOUNT"
                                android:textColor="#2E7D32"
                                android:textStyle="bold" />

                            <TextView
                                style="@style/CustomLargeDarkTextView"
                                android:layout_marginTop="@dimen/margin_2dp"
                                android:id="@+id/approvedAmount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                tools:text="₹ 1050.00"
                                android:text="@{@string/rupee_format(claim.latestApprovedAmount != null ? claim.latestApprovedAmount : 0.0)}"
                                android:textColor="@color/green"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.cardview.widget.CardView>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- ScrollView for Content -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:fillViewport="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/headerLayout">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="@dimen/margin_large">

                <!-- Basic Information Card -->
                <include
                    android:layout_marginHorizontal="@dimen/margin"
                    android:id="@+id/basicInfoCard"
                    layout="@layout/card_basic_information"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_small"
                    app:claim="@{claim}"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- Sites & Expenses Card -->
                <androidx.cardview.widget.CardView
                    android:layout_marginTop="@dimen/margin_medium"
                    android:layout_marginHorizontal="@dimen/margin"
                    android:id="@+id/cardSitesExpenses"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="@dimen/card_radius"
                    app:cardElevation="@dimen/elevation"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/basicInfoCard">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="@dimen/padding">

                        <ImageView
                            android:id="@+id/ivMapPin"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:contentDescription="@string/sites"
                            android:src="@drawable/ic_marker_on_24"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:tint="@color/colorPrimaryDark" />

                        <TextView
                            android:id="@+id/tvSitesTitle"
                            style="@style/CustomMediumDarkTextView"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/margin_small"
                            android:text="@string/sites_expenses"
                            android:textStyle="bold"
                            app:layout_constraintBottom_toBottomOf="@id/ivMapPin"
                            app:layout_constraintEnd_toStartOf="@id/tvSitesCount"
                            app:layout_constraintStart_toEndOf="@id/ivMapPin"
                            app:layout_constraintTop_toTopOf="@id/ivMapPin" />

                        <TextView
                            android:id="@+id/tvSitesCount"
                            style="@style/CustomMediumTextView"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@{@string/sites_count_calculation(claim.sites.size())}"
                            app:layout_constraintBottom_toBottomOf="@id/tvSitesTitle"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="@id/tvSitesTitle"
                            tools:text="3 sites" />

                        <!-- RecyclerView for Sites -->
                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/recyclerViewSites"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/margin"
                            android:nestedScrollingEnabled="false"
                            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/tvSitesTitle"
                            tools:itemCount="3"
                            tools:listitem="@layout/item_site" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </androidx.cardview.widget.CardView>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.core.widget.NestedScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>
