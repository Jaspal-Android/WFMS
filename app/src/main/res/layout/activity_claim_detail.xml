<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="viewModel"
            type="com.atvantiq.wfms.ui.screens.reimbursement.ReimbursementViewModel" />
        <variable
            name="claim"
            type="com.atvantiq.wfms.models.reimbursement.detail.ClaimData" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/wfmsColorBackground">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/headerLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="@dimen/margin"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Toolbar -->
            <include
                android:id="@+id/claimDetailsToolbar"
                layout="@layout/custom_toolbar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Status chip — in header, white border style -->
            <TextView
                android:id="@+id/tvStatus"
                style="@style/CustomSmallTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/margin"
                android:background="@drawable/status_primary_bg"
                android:paddingHorizontal="@dimen/padding_small"
                android:paddingVertical="@dimen/padding_x_small"
                android:text="@{claim.status}"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/claimDetailsToolbar"
                tools:text="Pending" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- ══════════════════════════════════════
             AMOUNT CARD — overlaps header bottom
             Negative top margin creates overlap effect
        ══════════════════════════════════════ -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardTotalAmount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin"
            android:layout_marginEnd="@dimen/margin"
            app:cardBackgroundColor="?attr/wfmsColorSurface"
            app:cardCornerRadius="@dimen/card_radius_max"
            app:cardElevation="@dimen/elevation"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/headerLayout">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="@dimen/padding"
                android:weightSum="2">

                <!-- Claim Amount Box -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/margin_small_extra"
                    android:layout_weight="1"
                    android:background="@drawable/info_chip_bg"
                    android:elevation="@dimen/elevation_small"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/padding_medium"
                    android:paddingVertical="@dimen/padding_small">

                    <TextView
                        android:id="@+id/claimAmountLabel"
                        style="@style/CustomSmallTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/claim_amount"
                        android:textAllCaps="true"
                        android:textColor="?attr/wfmsColorOnSurfaceVariant"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvAmount"
                        style="@style/CustomLargeTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_2dp"
                        android:text="@{@string/rupee_format(claim.totalAmount != null ? claim.totalAmount : 0.0)}"
                        android:textColor="?attr/wfmsColorOnSurface"
                        android:textStyle="bold"
                        tools:text="₹350.00" />
                </LinearLayout>

                <!-- Approved Amount Box -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_small_extra"
                    android:layout_weight="1"
                    android:background="@drawable/bg_approval_approved"
                    android:elevation="@dimen/elevation_small"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/padding_medium"
                    android:paddingVertical="@dimen/padding_small">

                    <TextView
                        style="@style/CustomSmallTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/approved_amount"
                        android:textAllCaps="true"
                        android:textColor="@color/status_present_text"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/approvedAmount"
                        style="@style/CustomLargeTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_2dp"
                        android:text="@{@string/rupee_format(claim.latestApprovedAmount != null ? claim.latestApprovedAmount : 0.0)}"
                        android:textColor="@color/status_present_text"
                        android:textStyle="bold"
                        tools:text="₹0.00" />
                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ══════════════════════════════════════
             SCROLLABLE CONTENT
        ══════════════════════════════════════ -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:fillViewport="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardTotalAmount">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/padding"
                android:paddingBottom="@dimen/margin_large">

                <!-- Basic Information Card -->
                <include
                    android:id="@+id/basicInfoCard"
                    layout="@layout/card_basic_information"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:claim="@{claim}"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- Sites & Expenses Card -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardSitesExpenses"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_small"
                    app:cardBackgroundColor="?attr/wfmsColorSurface"
                    app:cardCornerRadius="@dimen/card_radius_max"
                    app:cardElevation="@dimen/elevation_small"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/basicInfoCard">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="@dimen/padding">

                        <!-- Map pin icon -->
                        <ImageView
                            android:id="@+id/ivMapPin"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:contentDescription="@string/sites"
                            android:src="@drawable/ic_marker_on_24"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:tint="?attr/wfmsColorPrimary" />

                        <!-- Sites & Expenses title -->
                        <TextView
                            android:id="@+id/tvSitesTitle"
                            style="@style/CustomMediumTextView"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/margin_small"
                            android:text="@string/sites_expenses"
                            android:textColor="?attr/wfmsColorOnSurface"
                            android:textStyle="bold"
                            app:layout_constraintBottom_toBottomOf="@id/ivMapPin"
                            app:layout_constraintEnd_toStartOf="@id/tvSitesCount"
                            app:layout_constraintStart_toEndOf="@id/ivMapPin"
                            app:layout_constraintTop_toTopOf="@id/ivMapPin" />

                        <!-- Sites count badge -->
                        <TextView
                            android:id="@+id/tvSitesCount"
                            style="@style/CustomSmallTextView"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/icon_box_bg"
                            android:gravity="center"
                            android:paddingHorizontal="@dimen/padding_small"
                            android:paddingVertical="@dimen/padding_x_small"
                            android:text="@{@string/sites_count_calculation(claim.sites.size())}"
                            android:textColor="?attr/wfmsColorPrimary"
                            android:textStyle="bold"
                            app:layout_constraintBottom_toBottomOf="@id/tvSitesTitle"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="@id/tvSitesTitle"
                            tools:text="3 sites" />

                        <!-- Divider -->
                        <View
                            android:id="@+id/dividerSites"
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_marginTop="@dimen/margin_small"
                            android:alpha="0.1"
                            android:background="?attr/wfmsColorOnSurface"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/tvSitesTitle" />

                        <!-- Sites RecyclerView -->
                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/recyclerViewSites"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/margin_small"
                            android:nestedScrollingEnabled="false"
                            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/dividerSites"
                            tools:itemCount="2"
                            tools:listitem="@layout/item_site" />

                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.cardview.widget.CardView>

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.core.widget.NestedScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>