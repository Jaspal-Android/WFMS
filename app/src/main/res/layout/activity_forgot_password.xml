<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="vm"
            type="com.atvantiq.wfms.ui.screens.forgotPassword.vm.ForgotPasswordVM" />
    </data>

    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/wfmsColorBackground"
        android:orientation="vertical"
        tools:context=".ui.features.forgotPassword.ForgotPasswordActivity">

        <include
            android:id="@+id/toolbar"
            layout="@layout/custom_toolbar" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="@dimen/padding">

            <!-- FIX: replaced ic_logo ImageView with GradientLogoView -->
            <com.atvantiq.wfms.widgets.GradientLogoView
                android:id="@+id/logoView"
                android:layout_width="@dimen/item_category_small"
                android:layout_height="@dimen/item_category_small"
                android:layout_gravity="center"
                android:layout_marginBottom="@dimen/margin" />

            <!-- FIX: CustomLargeDarkTextView → CustomLargeTextView + theme color -->
            <TextView
                android:id="@+id/tv_forgot_password_title"
                style="@style/CustomLargeTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin"
                android:layout_marginBottom="@dimen/margin_small"
                android:text="@string/forgotYourPassword"
                android:textColor="?attr/wfmsColorOnSurface"
                android:textStyle="bold" />

            <!-- FIX: CustomRegularTextView + theme color -->
            <TextView
                android:id="@+id/tv_forgot_password_description"
                style="@style/CustomRegularTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margin_large"
                android:gravity="start"
                android:text="@string/enter_email_to_reset_password"
                android:textColor="?attr/wfmsColorOnSurfaceVariant" />

            <!-- Email field — unchanged -->
            <EditText
                android:id="@+id/phoneNumberEt"
                style="@style/CustomEditRegularStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin"
                android:layout_marginBottom="@dimen/margin_large"
                android:hint="@string/enter_email"
                android:imeOptions="actionDone"
                android:inputType="textEmailAddress"
                android:text="@={vm.emailAddress}" />

            <!-- Reset Password gradient button — unchanged -->
            <com.atvantiq.wfms.widgets.GradientButton
                android:id="@+id/btn_reset_password"
                style="@style/CustomButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:onClick="@{()->vm.onResetPasswordClick()}"
                android:text="@string/reset_password"
                android:textColor="@color/white"
                android:textStyle="bold" />

            <!-- FIX: wrong attr name fixed + theme color -->
            <TextView
                android:id="@+id/tv_back_to_login"
                style="@style/CustomMediumTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin"
                android:gravity="center"
                android:onClick="@{()->vm.onBackLoginClick()}"
                android:paddingEnd="@dimen/padding"
                android:paddingBottom="@dimen/padding_small"
                android:text="@string/back_to_login"
                android:textColor="?attr/wfmsColorPrimaryDark" />

        </LinearLayout>
    </LinearLayout>
</layout>