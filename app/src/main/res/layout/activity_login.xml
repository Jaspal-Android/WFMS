<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="isToggle"
            type="Boolean" />
        <variable
            name="vm"
            type="com.atvantiq.wfms.ui.screens.login.LoginVM" />
    </data>

    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="?attr/wfmsColorBackground"
        tools:context=".ui.features.login.LoginActivity">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <com.atvantiq.wfms.widgets.GradientLogoView
                    android:id="@+id/logoView"
                    android:layout_width="@dimen/item_category_small"
                    android:layout_height="@dimen/item_category_small"
                    android:layout_marginTop="@dimen/margin_huge"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- App name -->
                <TextView
                    android:id="@+id/appNameText"
                    style="@style/CustomLargeTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_small"
                    android:text="@string/app_name"
                    android:textColor="?attr/wfmsColorOnSurface"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/logoView" />

                <!-- App subtitle -->
                <TextView
                    android:id="@+id/appSubtitleText"
                    style="@style/CustomSmallTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_small_extra"
                    android:text="@string/wfms_dtails"
                    android:textColor="?attr/wfmsColorOnSurfaceVariant"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/appNameText" />



                <!-- ══════════════════════════════════════
                     WHITE FORM CARD
                ══════════════════════════════════════ -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/formCard"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/margin"
                    android:layout_marginTop="@dimen/margin_big"
                    app:cardBackgroundColor="?attr/wfmsColorSurface"
                    app:cardCornerRadius="@dimen/card_radius_max"
                    app:cardElevation="@dimen/elevation_small"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/appSubtitleText">


                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="@dimen/padding">

                        <!-- ── Welcome heading ── -->
                        <TextView
                            android:id="@+id/welcome_text"
                            style="@style/CustomLargeTextView"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/margin_large"
                            android:text="@string/welcome_back"
                            android:textColor="?attr/wfmsColorOnSurface"
                            android:textStyle="bold"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <!-- ── Subtitle ── -->
                        <TextView
                            android:id="@+id/login_instructions"
                            style="@style/CustomMediumTextView"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/login_to_continue"
                            android:textColor="?attr/wfmsColorOnSurfaceVariant"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/welcome_text" />


                        <!-- Username field -->
                        <EditText
                            android:id="@+id/phone_email_input"
                            style="@style/CustomEditRegularStyle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:hint="@string/enter_username"
                            android:imeOptions="actionNext"
                            android:inputType="textEmailAddress"
                            android:maxLines="1"
                            android:text="@={vm.userName}"
                            android:layout_marginTop="@dimen/margin_x_large"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/login_instructions" />

                        <!-- Password row -->
                        <LinearLayout
                            android:id="@+id/passwordView"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/margin"
                            android:background="@drawable/et_bg"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/phone_email_input">

                            <EditText
                                android:id="@+id/passwordEt"
                                style="@style/EditRegularNoBgStyle"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:hint="@string/enter_password"
                                android:imeOptions="actionDone"
                                android:inputType="textPassword"
                                android:maxLines="1"
                                android:text="@={vm.password}" />

                            <androidx.appcompat.widget.AppCompatImageView
                                android:id="@+id/password_toggle_bt"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/margin"
                                android:layout_marginEnd="@dimen/margin"
                                android:onClick="@{()->vm.onPasswordToggleClick()}"
                                app:tint="?attr/wfmsColorOnSurfaceVariant"
                                android:src="@{isToggle ? @drawable/baseline_visibility_off_24 : @drawable/baseline_visibility_24}" />

                        </LinearLayout>

                        <!-- Forgot password -->
                        <TextView
                            android:id="@+id/forgot_password"
                            style="@style/CustomSmallTextView"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/margin_small"
                            android:onClick="@{()->vm.onForgetPasswordClick()}"
                            android:text="@string/forgotYourPassword"
                            android:textColor="?attr/wfmsColorPrimaryDark"
                            android:textStyle="bold"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/passwordView" />

                        <!-- Login gradient button -->
                        <com.atvantiq.wfms.widgets.GradientButton
                            android:id="@+id/login_button"
                            style="@style/CustomButtonStyle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/margin_big"
                            android:onClick="@{()->vm.onSubmitLoginClick()}"
                            android:text="@string/login"
                            android:textStyle="bold"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/forgot_password" />

                        <!-- Login with OTP outline button -->
                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/login_otp_button"
                            style="@style/CustomPrimaryWireButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/margin"
                            android:onClick="@{()->vm.onLoginWithOtpClick()}"
                            android:text="@string/login_with_otp"
                            android:textStyle="bold"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/login_button" />

                        <!-- Divider -->
                        <View
                            android:id="@+id/divider"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/border_width_1dp"
                            android:layout_marginTop="@dimen/margin"
                            android:alpha="0.3"
                            android:background="?attr/wfmsColorOutline"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/login_otp_button" />

                        <!-- Location row -->
                        <LinearLayout
                            android:id="@+id/locationMarkerView"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/margin_small"
                            android:layout_marginBottom="@dimen/margin_small"
                            android:gravity="center_vertical"
                            android:onClick="@{()-> vm.onFetchCurrentLatitudeLongitudeClicks()}"
                            android:orientation="horizontal"
                            android:paddingTop="@dimen/padding_x_small"
                            android:paddingBottom="@dimen/padding_x_small"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/divider">

                            <ImageView
                                android:id="@+id/icLocationPic"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/ic_circular_bg"
                                android:padding="@dimen/padding_x_small"
                                android:src="@drawable/rounded_location_on_24"
                                app:tint="@color/white" />

                            <TextView
                                style="@style/CustomMediumTextView"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/margin_small"
                                android:text="@string/get_current_latitude_longitude"
                                android:textColor="?attr/wfmsColorOnSurfaceVariant" />

                        </LinearLayout>

                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.cardview.widget.CardView>

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.core.widget.NestedScrollView>

    </LinearLayout>
</layout>
