<?xml version="1.0" encoding="utf-8"?>
<layout>

    <data>

        <import type="android.view.View" />

        <variable
            name="vm"
            type="com.atvantiq.wfms.ui.screens.dashboard.DashboardViewModel" />

        <variable
            name="userNameString"
            type="String" />

        <variable
            name="isAttendacneCompleted"
            type="Boolean" />
    </data>

    <androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/wfmsColorBackground"
        android:fillViewport="true">

        <com.google.android.material.appbar.AppBarLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/wfmsColorBackground"
            app:elevation="0dp">

            <com.google.android.material.appbar.CollapsingToolbarLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:contentScrim="?attr/wfmsColorBackground"
                app:layout_scrollFlags="scroll|exitUntilCollapsed">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_collapseMode="parallax">

                    <!-- ════════════════════════════════════
                         HEADER BAR
                    ════════════════════════════════════ -->
                    <LinearLayout
                        android:id="@+id/headerBar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="@dimen/padding_small">

                        <com.atvantiq.wfms.widgets.GradientLogoView
                            android:layout_marginStart="@dimen/margin"
                            android:id="@+id/logoView"
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/dashboardLabel"
                            style="@style/CustomLargeTextView"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/margin_small"
                            android:layout_weight="1"
                            android:text="@string/menu_dashboard"
                            android:textColor="?attr/wfmsColorOnSurface"
                            android:textStyle="bold" />

                        <ImageButton
                            android:onClick="@{()->vm.onChangeThemeClick()}"
                            android:id="@+id/btnTheme"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/theme"
                            android:padding="@dimen/padding"
                            android:src="@drawable/ic_palette"
                            app:tint="?attr/wfmsColorOnSurface" />

           <!--             <ImageButton
                            android:id="@+id/btnNotification"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/notifications"
                            android:padding="@dimen/padding"
                            android:src="@drawable/ic_notifications_24"
                            app:tint="?attr/wfmsColorOnSurface" />-->
                    </LinearLayout>

                    <!-- ════════════════════════════════════
                         USER DETAILS CARD
                    ════════════════════════════════════ -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/cardDetails"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/margin"
                        android:foreground="?attr/selectableItemBackground"
                        app:cardBackgroundColor="?attr/wfmsColorSurface"
                        app:cardCornerRadius="@dimen/card_radius"
                        app:cardElevation="0dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="@dimen/margin_small"
                            android:layout_marginVertical="@dimen/margin"
                            android:orientation="vertical">

                            <!-- Greeting + Apply Leave -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/tvEmpName"
                                    style="@style/CustomLargeTextView"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginEnd="@dimen/margin_small"
                                    android:layout_weight="1"
                                    android:textColor="?attr/wfmsColorOnSurface"
                                    android:textStyle="bold"
                                    wishText="@{userNameString}"
                                    tools:text="Hello, Jaspal" />

                                <TextView
                                    android:id="@+id/applyLeaveBt"
                                    style="@style/CustomSmallTextView"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:background="@drawable/apply_leave_bg"
                                    android:onClick="@{()->vm.onApplyLeaveClick()}"
                                    android:paddingHorizontal="@dimen/padding"
                                    android:paddingVertical="@dimen/padding_small"
                                    android:text="@string/apply_leave"
                                    android:textStyle="bold" />

                            </LinearLayout>

                            <!-- Email + Role -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/margin_small"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/tvUserEmail"
                                    style="@style/CustomMediumTextView"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:textColor="?attr/wfmsColorOnSurfaceVariant"
                                    tools:text="jaspal@atvantiq.com" />

                                <TextView
                                    android:id="@+id/tvUserRole"
                                    style="@style/CustomMediumTextView"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="@dimen/margin_small"
                                    android:layout_weight="1"
                                    android:gravity="end"
                                    android:textColor="?attr/wfmsColorOnSurfaceVariant"
                                    tools:text="Circle Head" />
                            </LinearLayout>

                            <!-- Location row -->
                            <LinearLayout
                                android:id="@+id/locationMarkerView"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/margin"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingVertical="@dimen/padding_x_small">

                                <ImageView
                                    android:id="@+id/icLocationPic"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:background="@drawable/ic_circular_bg"
                                    android:contentDescription="@string/location"
                                    android:padding="2dp"
                                    android:src="@drawable/rounded_location_on_24" />

                                <TextView
                                    style="@style/CustomMediumTextView"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="@dimen/margin_small"
                                    android:onClick="@{()->vm.onFetchCurrentLatitudeLongitudeClicks()}"
                                    android:text="@string/get_current_latitude_longitude"
                                    android:textColor="?attr/wfmsColorOnSurfaceVariant" />
                            </LinearLayout>

                            <!-- Slide to start day -->
                            <com.ncorti.slidetoact.SlideToActView
                                android:id="@+id/slideStartDay"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/margin_small"
                                app:animation_duration="250"
                                app:area_margin="5dp"
                                app:border_radius="@dimen/card_radius"
                                app:bounce_on_start="true"
                                app:inner_color="@color/white"
                                app:outer_color="?attr/wfmsColorPrimary"
                                app:slider_height="50dp"
                                app:text="@string/start_day"
                                app:text_color="@color/white"
                                app:text_size="@dimen/default_text" />

                            <TextView
                                style="@style/CustomSmallTextView"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/margin_small_extra"
                                android:text="@string/attendance_completed_for_day"
                                android:textColor="?attr/wfmsColorError"
                                android:visibility="@{isAttendacneCompleted ? View.VISIBLE : View.GONE}" />

                        </LinearLayout>

                    </androidx.cardview.widget.CardView>

                </LinearLayout>
            </com.google.android.material.appbar.CollapsingToolbarLayout>

        </com.google.android.material.appbar.AppBarLayout>


        <!-- ════════════════════════════════════════
             SCROLLABLE NAVIGATION SECTION
        ════════════════════════════════════════ -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/constraintLayoutMain"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/navigationContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/margin"
                    android:layout_marginTop="@dimen/margin_large"
                    android:orientation="vertical">

                    <!-- Site Card -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/cardSite"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/margin"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:onClick="@{()->vm.onSitesClick()}"
                        app:cardBackgroundColor="?attr/wfmsColorSurface"
                        app:cardCornerRadius="@dimen/card_radius"
                        app:cardElevation="0dp"
                        app:strokeColor="?attr/wfmsColorOutline"
                        app:strokeWidth="@dimen/border_width_1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="@dimen/padding">

                            <androidx.cardview.widget.CardView
                                android:layout_width="@dimen/card_dashboard_height"
                                android:layout_height="@dimen/card_dashboard_height"
                                app:cardBackgroundColor="?attr/wfmsCard1Color"
                                app:cardCornerRadius="@dimen/card_radius_small"
                                app:cardElevation="0dp">

                                <ImageView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:contentDescription="@string/site"
                                    android:src="@drawable/ic_marker_on_24"
                                    app:tint="@android:color/white" />
                            </androidx.cardview.widget.CardView>

                            <TextView
                                style="@style/CustomLargeTextView"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/margin"
                                android:text="@string/site"
                                android:textColor="?attr/wfmsColorOnSurface"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Approve Site Card -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/cardApproveSite"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/margin"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:onClick="@{()-> vm.onSitesApprovalsClick()}"
                        app:cardBackgroundColor="?attr/wfmsColorSurface"
                        app:cardCornerRadius="@dimen/card_radius"
                        app:cardElevation="0dp"
                        app:strokeColor="?attr/wfmsColorOutline"
                        app:strokeWidth="@dimen/border_width_1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="@dimen/padding">

                            <androidx.cardview.widget.CardView
                                android:layout_width="@dimen/card_dashboard_height"
                                android:layout_height="@dimen/card_dashboard_height"
                                app:cardBackgroundColor="?attr/wfmsCard2Color"
                                app:cardCornerRadius="@dimen/card_radius_small"
                                app:cardElevation="0dp">

                                <ImageView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:contentDescription="@string/approve_site"
                                    android:src="@drawable/ic_check_circle_24"
                                    app:tint="@android:color/white" />
                            </androidx.cardview.widget.CardView>

                            <TextView
                                style="@style/CustomLargeTextView"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/margin"
                                android:text="@string/approve_site"
                                android:textColor="?attr/wfmsColorOnSurface"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Approve Claims Card -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/cardApproveClaims"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/margin"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:onClick="@{()->vm.onClaimApprovalsClick()}"
                        app:cardBackgroundColor="?attr/wfmsColorSurface"
                        app:cardCornerRadius="@dimen/card_radius"
                        app:cardElevation="0dp"
                        app:strokeColor="?attr/wfmsColorOutline"
                        app:strokeWidth="@dimen/border_width_1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="@dimen/padding">

                            <androidx.cardview.widget.CardView
                                android:layout_width="@dimen/card_dashboard_height"
                                android:layout_height="@dimen/card_dashboard_height"
                                app:cardBackgroundColor="?attr/wfmsCard4Color"
                                app:cardCornerRadius="@dimen/card_radius_small"
                                app:cardElevation="0dp">

                                <ImageView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:contentDescription="@string/approve_claims"
                                    android:src="@drawable/ic_approve_claim_24"
                                    app:tint="@android:color/white" />
                            </androidx.cardview.widget.CardView>

                            <TextView
                                style="@style/CustomLargeTextView"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/margin"
                                android:text="@string/approve_claims"
                                android:textColor="?attr/wfmsColorOnSurface"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                </LinearLayout>

                <!-- ════════════════════════════════════
                     LOGOUT
                ════════════════════════════════════ -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardLogout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/margin"
                    android:layout_marginTop="@dimen/margin_large"
                    android:layout_marginBottom="@dimen/margin"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:onClick="@{()->vm.onLogoutClick()}"
                    app:cardBackgroundColor="?attr/wfmsColorErrorLight"
                    app:cardCornerRadius="@dimen/card_radius"
                    app:cardElevation="0dp"
                    app:strokeColor="?attr/wfmsColorError"
                    app:strokeWidth="@dimen/border_width_1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:padding="@dimen/padding">

                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:contentDescription="@string/logout"
                            android:src="@drawable/ic_logout_24"
                            app:tint="?attr/wfmsColorError" />

                        <TextView
                            style="@style/CustomLargeTextView"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/margin"
                            android:text="@string/logout"
                            android:textColor="?attr/wfmsColorError"
                            android:textStyle="bold" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</layout>