<?xml version="1.0" encoding="utf-8"?>
<layout>

    <data>

        <import type="android.view.View" />

        <variable
            name="siteStatusInteger"
            type="Integer" />

        <variable
            name="showSelectAll"
            type="Boolean" />

        <variable
            name="hideButtons"
            type="Boolean" />

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/cardLightBackground">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="@dimen/padding"
                android:src="@drawable/arrow_back_ios_24"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvBack"
                style="@style/CustomRegularPrimaryTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/back"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="@+id/btnBack"
                app:layout_constraintStart_toEndOf="@id/btnBack"
                app:layout_constraintTop_toTopOf="@id/btnBack" />

            <TextView
                android:id="@+id/tvSiteName"
                style="@style/CustomLargeDarkTextView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin"
                android:layout_marginTop="@dimen/margin_small"
                tools:text="Chandigarh site"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/btnBack" />

            <TextView
                android:id="@+id/tvSiteCode"
                style="@style/CustomMediumDarkTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_small_extra"
                tools:text="CHD-345-POWN-234"
                app:layout_constraintStart_toStartOf="@+id/tvSiteName"
                app:layout_constraintTop_toBottomOf="@id/tvSiteName" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scrollContent"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:fillViewport="true"
            app:layout_constraintBottom_toTopOf="@id/layoutActions"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layoutHeader">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/padding">

                <!-- SITE INFORMATION CARD -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardSiteInfo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="@dimen/card_radius"
                    app:cardElevation="@dimen/elevation_small"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="@dimen/padding">

                        <TextView
                            android:id="@+id/tvInfoTitle"
                            style="@style/CustomRegularPrimaryTextView"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/site_information"
                            android:textStyle="bold"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/tvProjectLabel"
                            style="@style/CustomMediumTextView"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/margin_small"
                            android:text="@string/project"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/tvInfoTitle" />

                        <TextView
                            android:id="@+id/tvProject"
                            style="@style/CustomMediumDarkTextView"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ERRICSON-TOWER-110"
                            android:textStyle="bold"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/tvProjectLabel" />

                        <TextView
                            android:id="@+id/tvCircleLabel"
                            style="@style/CustomMediumTextView"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/margin_small"
                            android:text="@string/circle"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/tvProject" />

                        <TextView
                            android:id="@+id/tvCircle"
                            style="@style/CustomMediumDarkTextView"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Haryana (HR)"
                            android:textStyle="bold"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/tvCircleLabel" />

                        <TextView
                            android:id="@+id/tvStatus"
                            style="@style/CustomMediumTextView"
                            assignedSiteStatus="@{siteStatusInteger}"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/status_green_bg"
                            android:paddingHorizontal="@dimen/padding"
                            android:paddingVertical="@dimen/padding_x_small"
                            android:textColor="#16A34A"
                            android:textStyle="bold"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="@+id/tvInfoTitle"
                            tools:text="OPEN" />

                    </androidx.constraintlayout.widget.ConstraintLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- WORK TYPES -->
                <TextView
                    android:id="@+id/tvWorkTitle"
                    style="@style/CustomRegularDarkTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin"
                    android:text="WORK TYPES (3)"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/cardSiteInfo" />

                <!-- Select All Checkbox -->
                <CheckBox
                    android:layout_marginStart="@dimen/margin_small_extra"
                    android:id="@+id/cbSelectAllWorkTypes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_small"
                    android:visibility="@{showSelectAll ? View.VISIBLE : View.GONE}"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvWorkTitle" />

                <TextView
                    style="@style/CustomRegularDarkTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/select_all"
                    android:visibility="@{showSelectAll ? View.VISIBLE : View.GONE}"
                    app:layout_constraintBottom_toBottomOf="@+id/cbSelectAllWorkTypes"
                    app:layout_constraintStart_toEndOf="@+id/cbSelectAllWorkTypes"
                    app:layout_constraintTop_toTopOf="@+id/cbSelectAllWorkTypes" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvWorkTypes"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_small"
                    android:nestedScrollingEnabled="false"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/cbSelectAllWorkTypes"
                    tools:itemCount="2"
                    tools:listitem="@layout/item_work_type" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- BOTTOM ACTIONS -->

        <LinearLayout
            android:id="@+id/layoutActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="@dimen/padding"
            android:visibility="@{hideButtons ? View.GONE : View.VISIBLE}"
            app:layout_constraintBottom_toBottomOf="parent"
            tools:visibility="visible">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnApprove"
                style="@style/Widget.Material3.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:backgroundTint="@color/green"
                android:text="@string/approve"
                android:textColor="@color/white"
                android:textSize="@dimen/default_text"
                android:textStyle="bold"
                app:cornerRadius="@dimen/card_radius"
                app:icon="@drawable/ic_check_16"
                app:iconGravity="textStart"
                app:iconPadding="@dimen/padding_small"
                app:iconTint="@android:color/white"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/btnReject"
                app:layout_constraintTop_toTopOf="parent" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReject"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin"
                android:layout_weight="1"
                android:text="@string/reject"
                android:textColor="@color/red"
                android:textSize="@dimen/default_text"
                android:textStyle="bold"
                app:cornerRadius="@dimen/card_radius"
                app:icon="@drawable/ic_close_16"
                app:iconGravity="textStart"
                app:iconPadding="@dimen/padding_small"
                app:iconTint="@color/red"
                app:layout_constraintEnd_toStartOf="@id/btnApprove"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:strokeColor="@color/red_pastel"
                app:strokeWidth="1dp" />


        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
