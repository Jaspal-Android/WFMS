<?xml version="1.0" encoding="utf-8"?>
<!-- Site Work Detail (spec 7.3): the site summary, Work Types with Select All, one card per type,
     then Approve and Reject. -->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <import type="android.view.View" />

        <variable
            name="site"
            type="com.atvantiq.wfms.models.workSites.workSiteDetails.Data" />

        <variable
            name="showSelectAll"
            type="Boolean" />

        <variable
            name="hasSelection"
            type="Boolean" />

        <variable
            name="emptyMessage"
            type="String" />
    </data>

    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/wfmsColorBackground"
        android:fitsSystemWindows="true"
        android:orientation="vertical"
        tools:context=".ui.screens.admin.ui.siteApproval.workSiteDetail.SiteWorkDetailActivity">

        <include
            android:id="@+id/toolbar"
            layout="@layout/custom_toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/margin"
                android:paddingTop="@dimen/margin_small"
                android:paddingBottom="@dimen/margin">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="@{site == null ? View.GONE : View.VISIBLE}"
                    app:cardBackgroundColor="?attr/wfmsColorSurface"
                    app:cardCornerRadius="@dimen/card_radius"
                    app:cardElevation="0dp"
                    app:strokeColor="?attr/wfmsColorOutline"
                    app:strokeWidth="@dimen/border_width_1dp">

                    <include
                        layout="@layout/layout_site_summary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/padding"
                        app:circle="@{site.circle.name}"
                        app:project="@{site.project.name}"
                        app:siteId="@{site.site.siteId}"
                        app:siteName="@{site.site.name}"
                        app:statusCode="@{site.site.status.code}"
                        app:statusLabel="@{site.site.status.label}" />
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/CustomBigTextView"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:accessibilityHeading="true"
                        android:text="@string/work_types"
                        android:textColor="?attr/wfmsColorOnSurface"
                        android:textStyle="bold" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSelectAll"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/select_all"
                        android:textColor="?attr/wfmsColorAccent"
                        android:visibility="@{safeUnbox(showSelectAll) ? View.VISIBLE : View.GONE}" />
                </LinearLayout>

                <TextView
                    style="@style/CustomRegularTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_small"
                    android:text="@{emptyMessage}"
                    android:textColor="?attr/wfmsColorOnSurfaceVariant"
                    android:visibility="@{emptyMessage == null ? View.GONE : View.VISIBLE}"
                    tools:text="@string/no_work_types_waiting" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvWorkTypes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:itemCount="1"
                    tools:listitem="@layout/item_work_type_admin" />

                <com.atvantiq.wfms.widgets.GradientButton
                    android:id="@+id/btnApprove"
                    style="@style/CustomButtonStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin"
                    android:enabled="@{safeUnbox(hasSelection)}"
                    android:text="@string/approve"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:visibility="@{safeUnbox(showSelectAll) ? View.VISIBLE : View.GONE}" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnReject"
                    style="@style/CustomPrimaryWireButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_small"
                    android:enabled="@{safeUnbox(hasSelection)}"
                    android:text="@string/reject"
                    android:textStyle="bold"
                    android:visibility="@{safeUnbox(showSelectAll) ? View.VISIBLE : View.GONE}" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
</layout>
