<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/wfmsColorBackground"
    tools:context=".ui.screens.SplashActivity">

    <View
        android:id="@+id/topAccent"
        android:layout_width="0dp"
        android:layout_height="@dimen/border_width_1dp"
        android:background="?attr/wfmsColorPrimary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- ── Logo card ── -->
    <androidx.cardview.widget.CardView
        android:id="@+id/logoCard"
        android:layout_width="@dimen/nav_header_height"
        android:layout_height="@dimen/nav_header_height"
        android:layout_marginBottom="@dimen/margin_big"
        app:cardBackgroundColor="?attr/wfmsColorSurface"
        app:cardCornerRadius="@dimen/card_radius_large"
        app:cardElevation="@dimen/elevation"
        app:layout_constraintBottom_toTopOf="@+id/appNameText"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.42"
        app:layout_constraintVertical_chainStyle="packed">

        <ImageView
            android:id="@+id/logoImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_logo" />

    </androidx.cardview.widget.CardView>

    <!-- ── App name ── -->
    <TextView
        android:id="@+id/appNameText"
        style="@style/CustomLargeTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/margin_small_extra"
        android:text="@string/app_name"
        android:textColor="?attr/wfmsColorOnSurface"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/appTaglineText"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/logoCard" />

    <!-- ── Tagline ── -->
    <TextView
        android:id="@+id/appTaglineText"
        style="@style/CustomSmallTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/margin_big"
        android:text="@string/wfms_dtails"
        android:textColor="?attr/wfmsColorOnSurfaceVariant"
        app:layout_constraintBottom_toTopOf="@+id/loadingIndicator"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/appNameText" />

    <!-- ── Loading indicator ── -->
    <ProgressBar
        android:id="@+id/loadingIndicator"
        style="?android:attr/progressBarStyleSmall"
        android:layout_width="@dimen/margin_big"
        android:layout_height="@dimen/margin_big"
        android:layout_marginBottom="@dimen/margin_x_large"
        android:indeterminateTint="?attr/wfmsColorPrimary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/appTaglineText" />

    <!-- ── Divider ── -->
    <View
        android:id="@+id/brandDivider"
        android:layout_width="@dimen/margin_x_large"
        android:layout_height="@dimen/border_width_1dp"
        android:layout_marginBottom="@dimen/margin_small"
        android:alpha="0.4"
        android:background="?attr/wfmsColorOutline"
        app:layout_constraintBottom_toTopOf="@+id/brandText"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- ── Brand name ── -->
    <TextView
        android:id="@+id/brandText"
        style="@style/CustomSmallTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/margin_small_extra"
        android:text="@string/atvantiq_networks"
        android:textAllCaps="true"
        android:textColor="?attr/wfmsColorOnSurfaceVariant"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/versionText"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- ── Version ── -->
    <TextView
        android:id="@+id/versionText"
        style="@style/CustomSmallTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/padding_large"
        android:alpha="0.6"
        android:textColor="?attr/wfmsColorOnSurfaceVariant"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:text="v1.0.0" />

</androidx.constraintlayout.widget.ConstraintLayout>