<?xml version="1.0" encoding="utf-8"?>
<!-- Work Sites: the employee-day's card, then one card per site worked that day. -->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <import type="android.view.View" />

        <variable
            name="employee"
            type="com.atvantiq.wfms.models.workSites.workSites.Employee" />

        <variable
            name="dateLabel"
            type="String" />
    </data>

    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/wfmsColorBackground"
        android:fitsSystemWindows="true"
        android:orientation="vertical"
        tools:context=".ui.screens.admin.ui.siteApproval.workSites.WorkSitesActivity">

        <include
            android:id="@+id/siteApprovalToolbar"
            layout="@layout/custom_toolbar" />

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipeRefreshLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/margin"
                    android:paddingTop="@dimen/margin_small"
                    android:paddingBottom="@dimen/margin">

                    <!-- Employee -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="@{employee == null ? View.GONE : View.VISIBLE}"
                        app:cardBackgroundColor="?attr/wfmsColorSurface"
                        app:cardCornerRadius="@dimen/card_radius"
                        app:cardElevation="0dp"
                        app:strokeColor="?attr/wfmsColorOutline"
                        app:strokeWidth="@dimen/border_width_1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="@dimen/padding">

                            <ImageView
                                android:layout_width="@dimen/employee_avatar_size"
                                android:layout_height="@dimen/employee_avatar_size"
                                android:background="@drawable/bg_circle_primary"
                                android:importantForAccessibility="no"
                                android:padding="@dimen/padding_small"
                                android:src="@drawable/ic_person"
                                app:tint="@color/white" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/margin_medium"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    style="@style/CustomLargeTextView"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@{employee.name}"
                                    android:textColor="?attr/wfmsColorOnSurface"
                                    android:textStyle="bold"
                                    tools:text="Jaspal" />

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/margin_small_extra"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <ImageView
                                        android:layout_width="@dimen/icon_size_small"
                                        android:layout_height="@dimen/icon_size_small"
                                        android:importantForAccessibility="no"
                                        android:src="@drawable/ic_calendar_today"
                                        app:tint="?attr/wfmsColorOnSurfaceVariant" />

                                    <TextView
                                        style="@style/CustomRegularTextView"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="@dimen/margin_small_extra"
                                        android:text="@{dateLabel}"
                                        android:textColor="?attr/wfmsColorOnSurfaceVariant"
                                        tools:text="22 Sep 2026" />

                                    <ImageView
                                        android:layout_width="@dimen/icon_size_small"
                                        android:layout_height="@dimen/icon_size_small"
                                        android:layout_marginStart="@dimen/margin"
                                        android:importantForAccessibility="no"
                                        android:src="@drawable/ic_briefcase_16"
                                        app:tint="?attr/wfmsColorOnSurfaceVariant" />

                                    <TextView
                                        style="@style/CustomRegularTextView"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="@dimen/margin_small_extra"
                                        android:text="@{@string/role_format(employee.designation ?? @string/not_available_value)}"
                                        android:textColor="?attr/wfmsColorOnSurfaceVariant"
                                        tools:text="Role: IT" />
                                </LinearLayout>
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvWorkSites"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                        tools:itemCount="2"
                        tools:listitem="@layout/item_work_site" />

                    <include
                        android:id="@+id/emptyState"
                        layout="@layout/layout_empty_card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_medium"
                        app:icon="@{@drawable/ic_location_on}"
                        app:message="@{@string/no_work_sites_found}" />
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
    </LinearLayout>
</layout>
