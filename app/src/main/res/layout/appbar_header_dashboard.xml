<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="vm"
            type="com.atvantiq.wfms.ui.screens.dashboard.DashboardViewModel" />
        <variable
            name="userData"
            type="com.atvantiq.wfms.models.empDetail.EmpData" />
    </data>

    <com.google.android.material.appbar.CollapsingToolbarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:contentScrim="?attr/wfmsColorBackground"
        app:layout_scrollFlags="scroll|exitUntilCollapsed">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/wfmsColorBackground"
            android:paddingHorizontal="@dimen/padding"
            android:paddingTop="@dimen/padding"
            android:paddingBottom="@dimen/padding_small"
            app:layout_collapseMode="parallax">

            <!-- ── Employee name ── -->
            <TextView
                android:id="@+id/tvEmpName"
                style="@style/CustomLargeTextView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/margin_small"
                android:text="@{userData.name != null ? userData.name : @string/default_name}"
                android:textColor="?attr/wfmsColorOnSurface"
                android:textStyle="bold"
                app:layout_constraintEnd_toStartOf="@+id/applyLeaveBt"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="Hello, Jaspal" />

            <!-- ── Apply Leave button — FIX: theme-aware ── -->
            <TextView
                android:id="@+id/applyLeaveBt"
                style="@style/CustomSmallTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/apply_leave_bg_touch"
                android:elevation="@dimen/elevation_small"
                android:gravity="center_vertical"
                android:minHeight="@dimen/min_touch_target"
                android:onClick="@{()->vm.onApplyLeaveClick()}"
                android:paddingHorizontal="@dimen/padding"
                android:paddingVertical="@dimen/padding_small"
                android:text="@string/apply_leave"
                android:textColor="?attr/wfmsColorPrimary"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- ── Location row ── -->
            <LinearLayout
                android:id="@+id/locationMarkerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_small_extra"
                android:gravity="center_vertical"
                android:minHeight="@dimen/min_touch_target"
                android:onClick="@{()->vm.onFetchCurrentLatitudeLongitudeClicks()}"
                android:orientation="horizontal"
                android:paddingVertical="@dimen/padding_x_small"
                app:layout_constraintTop_toBottomOf="@+id/tvEmpName">

                <!-- FIX: padding dimen + tint -->
                <ImageView
                    android:id="@+id/icLocationPic"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/ic_circular_bg"
                    android:padding="@dimen/padding_x_small"
                    android:importantForAccessibility="no"
                    android:src="@drawable/rounded_location_on_24" />

                <!-- FIX: Dark style removed -->
                <TextView
                    style="@style/CustomMediumTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_small"
                    android:text="@string/get_current_latitude_longitude"
                    android:textColor="?attr/wfmsColorOnSurfaceVariant" />
            </LinearLayout>

            <!-- ── Shift tracking card: shown only while a day is active ── -->
            <LinearLayout
                android:id="@+id/trackingCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin"
                android:background="@drawable/bg_card_outlined"
                android:orientation="vertical"
                android:padding="@dimen/padding_medium"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/locationMarkerView"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/ivTrackingIcon"
                        android:layout_width="@dimen/tracking_icon_size"
                        android:layout_height="@dimen/tracking_icon_size"
                        android:background="@drawable/bg_timeline_icon"
                        android:importantForAccessibility="no"
                        android:padding="@dimen/timeline_icon_padding"
                        tools:src="@drawable/ic_tracking_navigation" />

                    <TextView
                        android:id="@+id/tvTrackingMessage"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/margin_small"
                        android:layout_weight="1"
                        android:textColor="?attr/wfmsColorOnSurface"
                        android:textSize="@dimen/default_text"
                        android:textStyle="bold"
                        tools:text="Tracking your shift · since 1:03 PM" />
                </LinearLayout>

                <!-- wrap_content over the style's 48dp minHeight: the same size at normal text sizes,
                     taller instead of clipped when the user's font size is large. -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTrackingPause"
                    style="@style/Widget.WFMS.TrackingButton.Filled"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/tracking_button_margin_top"
                    android:text="@string/pause_15_min"
                    app:icon="@drawable/ic_tracking_pause" />

                <!-- Resume / Fix / Open Settings, set per state -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTrackingAction"
                    style="@style/Widget.WFMS.TrackingButton.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/tracking_button_margin_top"
                    android:visibility="gone"
                    tools:text="@string/resume" />
            </LinearLayout>

            <!-- ── Slide to Start Day — FIX: outer_color attr ── -->
            <com.ncorti.slidetoact.SlideToActView
                android:id="@+id/slideStartDay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin"
                app:animation_duration="250"
                app:area_margin="5dp"
                app:border_radius="@dimen/card_radius"
                app:bounce_on_start="true"
                app:bounce_repeat="@integer/day_slider_hint_bounces"
                app:inner_color="@color/white"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/trackingCard"
                app:outer_color="?attr/wfmsColorPrimary"
                app:slider_height="52dp"
                app:text="@string/start_day"
                app:text_color="@color/white"
                app:text_size="@dimen/default_text" />

            <!-- ══════════════════════════════════════
                 COMPACT 2×2 INFO GRID
                 Replaces the 4-text inline row
            ══════════════════════════════════════ -->
            <androidx.gridlayout.widget.GridLayout
                android:id="@+id/infoGrid"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_small"
                app:columnCount="2"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/slideStartDay"
                app:rowCount="2"
                app:useDefaultMargins="false">

                <!-- Circle -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/margin_small_extra"
                    android:background="@drawable/info_chip_bg"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/padding_small"
                    android:paddingEnd="@dimen/padding_small"
                    android:paddingTop="@dimen/padding_x_small"
                    android:paddingBottom="@dimen/padding_x_small"
                    app:layout_columnWeight="1">

                    <TextView
                        style="@style/CustomSmallTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/circle_label"
                        android:textAllCaps="true"
                        android:textColor="?attr/wfmsColorOnSurfaceVariant"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvCircle"
                        style="@style/CustomRegularTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@{userData.circleDisplay.isEmpty() ? @string/default_value : userData.circleDisplay}"
                        android:textColor="?attr/wfmsColorOnSurface"
                        android:textStyle="bold"
                        tools:text="CHD" />
                </LinearLayout>

                <!-- Date of Joining -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/margin_small_extra"
                    android:background="@drawable/info_chip_bg"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/padding_small"
                    android:paddingEnd="@dimen/padding_small"
                    android:paddingTop="@dimen/padding_x_small"
                    android:paddingBottom="@dimen/padding_x_small"
                    app:layout_columnWeight="1">

                    <TextView
                        style="@style/CustomSmallTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/date_of_joining_label"
                        android:textAllCaps="true"
                        android:textColor="?attr/wfmsColorOnSurfaceVariant"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/dojText"
                        style="@style/CustomRegularTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@{userData.dateOfJoining != null ? userData.dateOfJoining : @string/default_value}"
                        android:textColor="?attr/wfmsColorOnSurface"
                        android:textStyle="bold"
                        tools:text="2026-11-02" />
                </LinearLayout>

                <!-- Reporting Manager -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/margin_small_extra"
                    android:background="@drawable/info_chip_bg"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/padding_small"
                    android:paddingEnd="@dimen/padding_small"
                    android:paddingTop="@dimen/padding_x_small"
                    android:paddingBottom="@dimen/padding_x_small"
                    app:layout_columnWeight="1">

                    <TextView
                        style="@style/CustomSmallTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/reporting_manager_label"
                        android:textAllCaps="true"
                        android:textColor="?attr/wfmsColorOnSurfaceVariant"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/reportingManagerText"
                        style="@style/CustomRegularTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@{userData.reportingManager != null ? (userData.reportingManager.name != null ? userData.reportingManager.name : @string/default_value) : @string/default_value}"
                        android:textColor="?attr/wfmsColorOnSurface"
                        android:textStyle="bold"
                        tools:text="John Doe" />
                </LinearLayout>

                <!-- Designation -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/margin_small_extra"
                    android:background="@drawable/info_chip_bg"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/padding_small"
                    android:paddingEnd="@dimen/padding_small"
                    android:paddingTop="@dimen/padding_x_small"
                    android:paddingBottom="@dimen/padding_x_small"
                    app:layout_columnWeight="1">

                    <TextView
                        style="@style/CustomSmallTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/designation_label"
                        android:textAllCaps="true"
                        android:textColor="?attr/wfmsColorOnSurfaceVariant"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/designationText"
                        style="@style/CustomRegularTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@{userData.designation != null ? userData.designation : @string/default_value}"
                        android:textColor="?attr/wfmsColorOnSurface"
                        android:textStyle="bold"
                        tools:text="IT Head" />
                </LinearLayout>

            </androidx.gridlayout.widget.GridLayout>

            <!-- ── Announcements (hidden, preserved) ── -->
            <TextView
                android:id="@+id/announcementText"
                style="@style/CustomRegularTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin"
                android:drawableStart="@drawable/volume_up_24"
                android:drawablePadding="@dimen/padding_small"
                android:text="@string/announcements"
                android:textColor="?attr/wfmsColorOnSurface"
                android:textStyle="bold"
                android:visibility="gone"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/infoGrid" />

            <TextView
                style="@style/CustomSmallLightTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/small_primary_bg"
                android:elevation="@dimen/elevation"
                android:onClick="@{()-> vm.onAnnouncementsClicks()}"
                android:paddingStart="@dimen/padding_medium"
                android:paddingTop="@dimen/padding_x_small"
                android:paddingEnd="@dimen/padding_medium"
                android:paddingBottom="@dimen/padding_x_small"
                android:text="@string/view_all"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/announcementText" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.appbar.CollapsingToolbarLayout>
</layout>