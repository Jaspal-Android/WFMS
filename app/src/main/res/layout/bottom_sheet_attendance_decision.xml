<?xml version="1.0" encoding="utf-8"?>
<!-- Attendance Decision sheet: Close + title, the decision form and Submit Attendance Decision. -->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable
            name="vm"
            type="com.atvantiq.wfms.ui.screens.admin.ui.attendanceApproval.AttendanceApprovalVM" />
    </data>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/padding">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_pull" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_small">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnClose"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start|center_vertical"
                    android:text="@string/close"
                    android:textColor="?attr/wfmsColorOnSurface" />

                <TextView
                    style="@style/CustomLargeTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:accessibilityHeading="true"
                    android:text="@string/attendance_decision"
                    android:textColor="?attr/wfmsColorOnSurface"
                    android:textStyle="bold" />
            </FrameLayout>

            <include
                android:id="@+id/form"
                layout="@layout/layout_attendance_decision_form"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin"
                app:vm="@{vm}" />

            <com.atvantiq.wfms.widgets.GradientButton
                android:id="@+id/btnSubmit"
                style="@style/CustomButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin"
                android:onClick="@{() -> vm.submitDecision()}"
                android:text="@string/submit_attendance_decision"
                android:textColor="@color/white"
                android:textStyle="bold" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</layout>
