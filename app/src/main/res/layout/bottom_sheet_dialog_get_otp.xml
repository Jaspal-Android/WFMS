<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/padding"
        android:focusableInTouchMode="true"
        android:descendantFocusability="beforeDescendants">

        <!-- ── Pull handle ── -->
        <ImageView
            android:layout_width="@dimen/margin_x_large"
            android:layout_height="@dimen/margin_small_extra"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="@dimen/margin"
            android:src="@drawable/ic_pull" />

        <!-- ── Title ── -->
        <TextView
            android:id="@+id/otp_title"
            style="@style/CustomLargeTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginBottom="@dimen/margin_small"
            android:text="@string/please_enter_otp"
            android:textColor="?attr/wfmsColorOnSurface"
            android:textStyle="bold" />

        <!-- ── Subtitle ── -->
        <TextView
            style="@style/CustomMediumTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginBottom="@dimen/margin_big"
            android:gravity="center"
            android:text="@string/we_have_sent_otp_email"
            android:textColor="?attr/wfmsColorOnSurfaceVariant" />

        <!-- ── OTP boxes ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/margin_large"
            android:gravity="center_horizontal"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/otp_box_1"
                style="@style/EditOTPStyle"
                android:background="@drawable/otp_box_background"
                android:digits="0123456789"
                android:gravity="center"
                android:imeOptions="actionNext"
                android:inputType="numberPassword"
                android:maxLength="1"
                tools:text="1" />

            <Space
                android:layout_width="@dimen/margin_small_extra"
                android:layout_height="0dp" />

            <EditText
                android:id="@+id/otp_box_2"
                style="@style/EditOTPStyle"
                android:background="@drawable/otp_box_background"
                android:digits="0123456789"
                android:gravity="center"
                android:imeOptions="actionNext"
                android:inputType="numberPassword"
                android:maxLength="1" />

            <Space
                android:layout_width="@dimen/margin_small_extra"
                android:layout_height="0dp" />

            <EditText
                android:id="@+id/otp_box_3"
                style="@style/EditOTPStyle"
                android:background="@drawable/otp_box_background"
                android:digits="0123456789"
                android:gravity="center"
                android:imeOptions="actionNext"
                android:inputType="numberPassword"
                android:maxLength="1" />

            <Space
                android:layout_width="@dimen/margin_small_extra"
                android:layout_height="0dp" />

            <EditText
                android:id="@+id/otp_box_4"
                style="@style/EditOTPStyle"
                android:background="@drawable/otp_box_background"
                android:digits="0123456789"
                android:gravity="center"
                android:imeOptions="actionNext"
                android:inputType="numberPassword"
                android:maxLength="1" />

            <Space
                android:layout_width="@dimen/margin_small_extra"
                android:layout_height="0dp" />

            <EditText
                android:id="@+id/otp_box_5"
                style="@style/EditOTPStyle"
                android:background="@drawable/otp_box_background"
                android:digits="0123456789"
                android:gravity="center"
                android:imeOptions="actionNext"
                android:inputType="numberPassword"
                android:maxLength="1" />

            <Space
                android:layout_width="@dimen/margin_small_extra"
                android:layout_height="0dp" />

            <EditText
                android:id="@+id/otp_box_6"
                style="@style/EditOTPStyle"
                android:background="@drawable/otp_box_background"
                android:digits="0123456789"
                android:gravity="center"
                android:imeOptions="actionDone"
                android:inputType="numberPassword"
                android:maxLength="1" />

        </LinearLayout>

        <!-- ── Resend OTP ── -->
        <TextView
            android:id="@+id/resend_otp_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:paddingTop="@dimen/margin"
            android:paddingBottom="@dimen/margin"
            android:text="@string/resend_otp"
            android:textColor="?attr/wfmsColorPrimary"
            android:textStyle="bold"
            android:visibility="gone"
            tools:visibility="visible" />

        <!-- ── Submit gradient button ── -->
        <com.atvantiq.wfms.widgets.GradientButton
            android:id="@+id/btn_submit"
            style="@style/CustomButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin"
            android:layout_marginBottom="@dimen/margin_small"
            android:enabled="true"
            android:text="@string/submit"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:visibility="invisible"
            tools:visibility="visible" />

    </LinearLayout>
</layout>