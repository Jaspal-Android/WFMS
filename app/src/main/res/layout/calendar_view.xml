<?xml version="1.0" encoding="utf-8"?>
<layout>

    <data>
        <import type="android.view.View" />
        <variable
            name="hideNextBt"
            type="Boolean" />
    </data>

    <androidx.appcompat.widget.LinearLayoutCompat
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- ── Month / Year Navigation ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/padding"
            android:paddingEnd="@dimen/padding"
            android:paddingTop="@dimen/padding_small"
            android:paddingBottom="@dimen/padding_small">

            <!--
                FIX: Added ic_circular_bg (primaryLight oval) + tint for arrow
                     Matches projected design nav button style
            -->
            <ImageView
                android:id="@+id/btnPreviousMonth"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/primary_bt_oval_bg"
                android:padding="@dimen/padding_small"
                android:src="@drawable/arrow_back_ios_24"
                android:contentDescription="@string/previous_month"
                app:tint="?attr/wfmsColorPrimaryLight" />

            <!-- FIX: CustomRegularDarkTextView → theme-aware color -->
            <TextView
                android:id="@+id/tvMonthYear"
                style="@style/CustomRegularTextView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                tools:text="January 2026"
                android:textColor="?attr/wfmsColorOnSurface"
                android:textStyle="bold" />

            <!-- FIX: same as prev button, consistent padding -->
            <ImageView
                android:id="@+id/btnNextMonth"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/primary_bt_oval_bg"
                android:padding="@dimen/padding_small"
                android:src="@drawable/arrow_forward_ios_24"
                android:visibility="@{hideNextBt ? View.INVISIBLE : View.VISIBLE}"
                android:contentDescription="@string/next_month"
                app:tint="?attr/wfmsColorPrimaryLight" />

        </LinearLayout>

        <!-- ── Day headers S M T W T F S ── -->
        <LinearLayout
            android:id="@+id/calendar_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/margin_small"
            android:paddingEnd="@dimen/margin_small"
            android:paddingTop="@dimen/padding_x_small"
            android:paddingBottom="@dimen/padding_x_small">

            <!-- FIX: CustomMediumPrimaryTextView → explicit wfmsColorPrimary -->
            <TextView
                style="@style/CustomSmallTextView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/weekday_initial_sun"
                android:textColor="?attr/wfmsColorAccent"
                android:textStyle="bold" />

            <TextView
                style="@style/CustomSmallTextView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/weekday_initial_mon"
                android:textColor="?attr/wfmsColorAccent"
                android:textStyle="bold" />

            <TextView
                style="@style/CustomSmallTextView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/weekday_initial_tue"
                android:textColor="?attr/wfmsColorAccent"
                android:textStyle="bold" />

            <TextView
                style="@style/CustomSmallTextView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/weekday_initial_wed"
                android:textColor="?attr/wfmsColorAccent"
                android:textStyle="bold" />

            <TextView
                style="@style/CustomSmallTextView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/weekday_initial_thu"
                android:textColor="?attr/wfmsColorAccent"
                android:textStyle="bold" />

            <TextView
                style="@style/CustomSmallTextView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/weekday_initial_fri"
                android:textColor="?attr/wfmsColorAccent"
                android:textStyle="bold" />

            <TextView
                style="@style/CustomSmallTextView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/weekday_initial_sat"
                android:textColor="?attr/wfmsColorAccent"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- ── Calendar Grid ── -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/calendarGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_small"
            android:layout_marginTop="@dimen/margin_small"
            android:layout_marginEnd="@dimen/margin_small"
            android:layout_marginBottom="@dimen/margin_small"
            android:layout_weight="1"
            android:nestedScrollingEnabled="true"
            tools:listitem="@layout/item_calendar_day" />

    </androidx.appcompat.widget.LinearLayoutCompat>
</layout>