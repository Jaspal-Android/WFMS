<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <import type="android.view.View" />
        <variable
            name="vm"
            type="com.atvantiq.wfms.ui.screens.attendance.AttendanceViewModel" />
        <variable
            name="isEmptyAssignedTasks"
            type="Boolean" />
    </data>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/wfmsColorBackground"
        tools:context=".ui.screens.attendance.AttendanceFragment">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="@dimen/padding">

                <!-- ══════════════════════════════════════
                     SELF WORK ASSIGN CARD
                ══════════════════════════════════════ -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/margin"
                    app:cardBackgroundColor="?attr/wfmsColorSurface"
                    app:cardCornerRadius="@dimen/card_radius"
                    app:cardElevation="@dimen/elevation_small">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:onClick="@{()->vm.onSignInClick()}"
                        android:padding="@dimen/padding">

                        <!-- Icon box -->
                        <ImageView
                            android:padding="@dimen/padding_small"
                            android:id="@+id/iconSelfAssign"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/icon_box_bg"
                            android:src="@drawable/round_add_box_24"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:tint="?attr/wfmsColorPrimary" />

                        <!-- Title + subtitle -->
                        <TextView
                            android:id="@+id/signInText"
                            style="@style/CustomRegularTextView"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/margin_small"
                            android:text="@string/self_work_assign"
                            android:textAllCaps="true"
                            android:textColor="?attr/wfmsColorPrimary"
                            android:textStyle="bold"
                            app:layout_constraintEnd_toStartOf="@+id/arrowSelfAssign"
                            app:layout_constraintStart_toEndOf="@+id/iconSelfAssign"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            style="@style/CustomSmallTextView"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/margin_small"
                            android:layout_marginTop="@dimen/margin_small_extra"
                            android:text="@string/create_new_work_assignment"
                            android:textColor="?attr/wfmsColorOnSurfaceVariant"
                            app:layout_constraintEnd_toStartOf="@+id/arrowSelfAssign"
                            app:layout_constraintStart_toEndOf="@+id/iconSelfAssign"
                            app:layout_constraintTop_toBottomOf="@+id/signInText" />

                        <!-- Forward arrow -->
                        <ImageView
                            android:id="@+id/arrowSelfAssign"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/forward_arrow_right_24"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:tint="?attr/wfmsColorOnSurfaceVariant" />

                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.cardview.widget.CardView>

                <!-- ══════════════════════════════════════
                     SEARCH BAR
                ══════════════════════════════════════ -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/margin_small"
                    app:cardBackgroundColor="?attr/wfmsColorSurface"
                    app:cardCornerRadius="@dimen/card_radius_large"
                    app:cardElevation="@dimen/elevation_small">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/padding_medium"
                        android:paddingTop="10dp"
                        android:paddingEnd="@dimen/padding"
                        android:paddingBottom="10dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_search"
                            app:tint="?attr/wfmsColorOnSurfaceVariant" />

                        <EditText
                            android:id="@+id/etSearch"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/margin_small"
                            android:layout_weight="1"
                            android:background="@null"
                            android:hint="@string/search_by_site_or_project"
                            android:imeOptions="actionSearch"
                            android:inputType="text"
                            android:maxLines="1"
                            android:textColor="?attr/wfmsColorOnSurface"
                            android:textColorHint="?attr/wfmsColorOnSurfaceVariant"
                            android:textSize="@dimen/default_medium_small_text" />

                        <ImageView
                            android:id="@+id/ivClearSearch"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_close_16"
                            android:visibility="gone"
                            app:tint="?attr/wfmsColorOnSurfaceVariant" />

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- ══════════════════════════════════════
                     FILTER CHIPS
                ══════════════════════════════════════ -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/margin_small"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/filterChipsRow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/chipAll"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/margin_small"
                            android:background="@drawable/bg_filter_chip_selected"
                            android:paddingStart="@dimen/padding"
                            android:paddingTop="8dp"
                            android:paddingEnd="@dimen/padding"
                            android:paddingBottom="8dp"
                            android:text="@string/filter_all"
                            android:textColor="@color/white"
                            android:textSize="@dimen/default_medium_small_text"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/chipPending"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/margin_small"
                            android:background="@drawable/bg_filter_chip_unselected"
                            android:paddingStart="@dimen/padding"
                            android:paddingTop="8dp"
                            android:paddingEnd="@dimen/padding"
                            android:paddingBottom="8dp"
                            android:text="@string/filter_pending"
                            android:textColor="?attr/wfmsColorOnSurfaceVariant"
                            android:textSize="@dimen/default_medium_small_text"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/chipActive"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/margin_small"
                            android:background="@drawable/bg_filter_chip_unselected"
                            android:paddingStart="@dimen/padding"
                            android:paddingTop="8dp"
                            android:paddingEnd="@dimen/padding"
                            android:paddingBottom="8dp"
                            android:text="@string/filter_active"
                            android:textColor="?attr/wfmsColorOnSurfaceVariant"
                            android:textSize="@dimen/default_medium_small_text"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/chipCompleted"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_filter_chip_unselected"
                            android:paddingStart="@dimen/padding"
                            android:paddingTop="8dp"
                            android:paddingEnd="@dimen/padding"
                            android:paddingBottom="8dp"
                            android:text="@string/filter_completed"
                            android:textColor="?attr/wfmsColorOnSurfaceVariant"
                            android:textSize="@dimen/default_medium_small_text"
                            android:textStyle="bold" />

                    </LinearLayout>
                </HorizontalScrollView>

                <!-- ══════════════════════════════════════
                     TASK LIST + EMPTY STATE
                ══════════════════════════════════════ -->
                <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                    android:id="@+id/swipeRefreshLayout"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <!-- Task list -->
                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvAssignedTasks"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:clipToPadding="false"
                            android:visibility="@{isEmptyAssignedTasks ? View.GONE : View.VISIBLE}"
                            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                            tools:itemCount="3"
                            tools:listitem="@layout/item_assigned_tasks" />

                        <!-- Empty state -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerInParent="true"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:visibility="@{isEmptyAssignedTasks ? View.VISIBLE : View.GONE}"
                            tools:visibility="gone">

                            <com.airbnb.lottie.LottieAnimationView
                                android:id="@+id/animationView"
                                android:layout_width="150dp"
                                android:layout_height="150dp"
                                android:layout_gravity="center"
                                android:backgroundTint="@android:color/transparent"
                                app:lottie_autoPlay="true"
                                app:lottie_loop="true"
                                app:lottie_rawRes="@raw/no_data" />

                            <!-- FIX: no style/color → theme-aware -->
                            <TextView
                                style="@style/CustomMediumTextView"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:text="@string/no_work_details_found"
                                android:textColor="?attr/wfmsColorOnSurfaceVariant" />

                        </LinearLayout>

                    </RelativeLayout>
                </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

    </FrameLayout>
</layout>