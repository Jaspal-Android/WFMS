<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <import type="android.view.View" />
        <variable
            name="vm"
            type="com.atvantiq.wfms.ui.screens.attendance.AttendanceViewModel" />
        <variable
            name="isEmptyAssignedTasks"
            type="Boolean" />
    </data>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/wfmsColorBackground"
        tools:context=".ui.screens.attendance.AttendanceFragment">

        <!-- Header (search, add, filters) stays put; only the list scrolls. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="@dimen/padding"
            android:paddingTop="@dimen/padding"
            android:paddingEnd="@dimen/padding">

                <!-- ══════════════════════════════════════
                     SEARCH + SELF WORK ASSIGN
                ══════════════════════════════════════ -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/margin_small"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <include
                        android:id="@+id/searchBar"
                        layout="@layout/layout_search_bar"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/min_touch_target"
                        android:layout_weight="1"
                        app:hint="@{@string/search_by_site_or_project}" />

                    <!-- Self work assign: labelled, same height and corners as the search bar -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSelfAssign"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/min_touch_target"
                        android:layout_marginStart="@dimen/margin_small"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:contentDescription="@string/self_work_assign"
                        android:onClick="@{()->vm.onSignInClick()}"
                        android:paddingHorizontal="@dimen/padding"
                        android:text="@string/assign"
                        android:textColor="@color/white"
                        android:textStyle="bold"
                        app:backgroundTint="?attr/wfmsColorPrimary"
                        app:cornerRadius="@dimen/card_radius"
                        app:elevation="0dp"
                        app:icon="@drawable/ic_add"
                        app:iconTint="@color/white" />

                </LinearLayout>

                <!-- ══════════════════════════════════════
                     FILTER CHIPS
                ══════════════════════════════════════ -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/margin_small"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/filterChipsRow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/chipAll"
                            style="@style/CustomFilterChip"
                            android:background="@drawable/bg_filter_chip_selected"
                            android:text="@string/filter_all"
                            android:textColor="@color/white" />

                        <TextView
                            android:id="@+id/chipPending"
                            style="@style/CustomFilterChip"
                            android:background="@drawable/bg_filter_chip_unselected"
                            android:text="@string/filter_pending"
                            android:textColor="?attr/wfmsColorOnSurfaceVariant" />

                        <TextView
                            android:id="@+id/chipActive"
                            style="@style/CustomFilterChip"
                            android:background="@drawable/bg_filter_chip_unselected"
                            android:text="@string/filter_active"
                            android:textColor="?attr/wfmsColorOnSurfaceVariant" />

                        <TextView
                            android:id="@+id/chipCompleted"
                            style="@style/CustomFilterChip"
                            android:background="@drawable/bg_filter_chip_unselected"
                            android:text="@string/filter_completed"
                            android:textColor="?attr/wfmsColorOnSurfaceVariant" />

                    </LinearLayout>
                </HorizontalScrollView>

                <!-- ══════════════════════════════════════
                     TASK LIST + EMPTY STATE
                ══════════════════════════════════════ -->
                <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                    android:id="@+id/swipeRefreshLayout"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <!-- Task list -->
                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvAssignedTasks"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:clipToPadding="false"
                            android:visibility="@{isEmptyAssignedTasks ? View.GONE : View.VISIBLE}"
                            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                            tools:itemCount="3"
                            tools:listitem="@layout/item_assigned_tasks" />

                        <!-- Empty state -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerInParent="true"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:visibility="@{isEmptyAssignedTasks ? View.VISIBLE : View.GONE}"
                            tools:visibility="gone">

                            <com.airbnb.lottie.LottieAnimationView
                                android:id="@+id/animationView"
                                android:layout_width="150dp"
                                android:layout_height="150dp"
                                android:layout_gravity="center"
                                android:backgroundTint="@android:color/transparent"
                                app:lottie_autoPlay="true"
                                app:lottie_loop="true"
                                app:lottie_rawRes="@raw/no_data" />

                            <!-- FIX: no style/color → theme-aware -->
                            <TextView
                                style="@style/CustomMediumTextView"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:text="@string/no_work_details_found"
                                android:textColor="?attr/wfmsColorOnSurfaceVariant" />

                        </LinearLayout>

                    </RelativeLayout>
                </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        </LinearLayout>

    </FrameLayout>
</layout>