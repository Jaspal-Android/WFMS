<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <import type="android.view.View" />
        <variable
            name="vm"
            type="com.atvantiq.wfms.ui.screens.attendance.AttendanceViewModel" />
        <variable
            name="isEmptyAssignedTasks"
            type="Boolean" />
    </data>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/wfmsColorBackground"
        tools:context=".ui.screens.attendance.AttendanceFragment">

        <!-- Header (search, add, filters) stays put; only the list scrolls. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="@dimen/padding"
            android:paddingTop="@dimen/padding"
            android:paddingEnd="@dimen/padding">

                <!-- ══════════════════════════════════════
                     SEARCH + SELF WORK ASSIGN
                ══════════════════════════════════════ -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/margin_small"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="@dimen/min_touch_target"
                        android:layout_weight="1"
                        app:cardBackgroundColor="?attr/wfmsColorSurface"
                        app:cardCornerRadius="@dimen/card_radius"
                        app:cardElevation="@dimen/elevation_small">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="@dimen/padding_medium"
                            android:paddingEnd="@dimen/padding_x_small">

                            <ImageView
                                android:layout_width="@dimen/icon_size_small"
                                android:layout_height="@dimen/icon_size_small"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_search"
                                app:tint="?attr/wfmsColorOnSurfaceVariant" />

                            <EditText
                                android:id="@+id/etSearch"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_marginStart="@dimen/margin_small"
                                android:layout_weight="1"
                                android:background="@null"
                                android:hint="@string/search_by_site_or_project"
                                android:imeOptions="actionSearch"
                                android:inputType="text"
                                android:maxLines="1"
                                android:textColor="?attr/wfmsColorOnSurface"
                                android:textColorHint="?attr/wfmsColorOnSurfaceVariant"
                                android:textSize="@dimen/default_medium_small_text" />

                            <ImageView
                                android:id="@+id/ivClearSearch"
                                style="@style/CustomIconButton.Small"
                                android:contentDescription="@string/clear_search"
                                android:src="@drawable/ic_close_16"
                                android:visibility="gone"
                                app:tint="?attr/wfmsColorOnSurfaceVariant" />

                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Self work assign -->
                    <ImageButton
                        android:id="@+id/btnSelfAssign"
                        android:layout_width="@dimen/min_touch_target"
                        android:layout_height="@dimen/min_touch_target"
                        android:layout_marginStart="@dimen/margin_small"
                        android:background="@drawable/btn_primary_gradient"
                        android:contentDescription="@string/self_work_assign"
                        android:elevation="@dimen/elevation_small"
                        android:foreground="?attr/selectableItemBackground"
                        android:onClick="@{()->vm.onSignInClick()}"
                        android:src="@drawable/ic_add"
                        app:tint="@color/white" />

                </LinearLayout>

                <!-- ══════════════════════════════════════
                     FILTER CHIPS
                ══════════════════════════════════════ -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/margin_small"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/filterChipsRow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/chipAll"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/margin_small"
                            android:background="@drawable/bg_filter_chip_selected"
                            android:paddingStart="@dimen/padding"
                            android:paddingTop="8dp"
                            android:paddingEnd="@dimen/padding"
                            android:paddingBottom="8dp"
                            android:text="@string/filter_all"
                            android:textColor="@color/white"
                            android:textSize="@dimen/default_medium_small_text"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/chipPending"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/margin_small"
                            android:background="@drawable/bg_filter_chip_unselected"
                            android:paddingStart="@dimen/padding"
                            android:paddingTop="8dp"
                            android:paddingEnd="@dimen/padding"
                            android:paddingBottom="8dp"
                            android:text="@string/filter_pending"
                            android:textColor="?attr/wfmsColorOnSurfaceVariant"
                            android:textSize="@dimen/default_medium_small_text"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/chipActive"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/margin_small"
                            android:background="@drawable/bg_filter_chip_unselected"
                            android:paddingStart="@dimen/padding"
                            android:paddingTop="8dp"
                            android:paddingEnd="@dimen/padding"
                            android:paddingBottom="8dp"
                            android:text="@string/filter_active"
                            android:textColor="?attr/wfmsColorOnSurfaceVariant"
                            android:textSize="@dimen/default_medium_small_text"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/chipCompleted"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_filter_chip_unselected"
                            android:paddingStart="@dimen/padding"
                            android:paddingTop="8dp"
                            android:paddingEnd="@dimen/padding"
                            android:paddingBottom="8dp"
                            android:text="@string/filter_completed"
                            android:textColor="?attr/wfmsColorOnSurfaceVariant"
                            android:textSize="@dimen/default_medium_small_text"
                            android:textStyle="bold" />

                    </LinearLayout>
                </HorizontalScrollView>

                <!-- ══════════════════════════════════════
                     TASK LIST + EMPTY STATE
                ══════════════════════════════════════ -->
                <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                    android:id="@+id/swipeRefreshLayout"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <!-- Task list -->
                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvAssignedTasks"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:clipToPadding="false"
                            android:visibility="@{isEmptyAssignedTasks ? View.GONE : View.VISIBLE}"
                            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                            tools:itemCount="3"
                            tools:listitem="@layout/item_assigned_tasks" />

                        <!-- Empty state -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerInParent="true"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:visibility="@{isEmptyAssignedTasks ? View.VISIBLE : View.GONE}"
                            tools:visibility="gone">

                            <com.airbnb.lottie.LottieAnimationView
                                android:id="@+id/animationView"
                                android:layout_width="150dp"
                                android:layout_height="150dp"
                                android:layout_gravity="center"
                                android:backgroundTint="@android:color/transparent"
                                app:lottie_autoPlay="true"
                                app:lottie_loop="true"
                                app:lottie_rawRes="@raw/no_data" />

                            <!-- FIX: no style/color → theme-aware -->
                            <TextView
                                style="@style/CustomMediumTextView"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:text="@string/no_work_details_found"
                                android:textColor="?attr/wfmsColorOnSurfaceVariant" />

                        </LinearLayout>

                    </RelativeLayout>
                </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        </LinearLayout>

    </FrameLayout>
</layout>