<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable
            name="vm"
            type="com.atvantiq.wfms.ui.screens.dashboard.DashboardViewModel" />
    </data>

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/wfmsColorBackground">

        <com.google.android.material.appbar.AppBarLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/wfmsColorBackground"
            app:elevation="0dp">

            <include
                android:id="@+id/appDashHeader"
                layout="@layout/appbar_header_dashboard"
                app:vm="@{vm}" />

            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tabLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/wfmsColorBackground"
                android:contentDescription="@string/tab_layout_desc"
                app:tabGravity="fill"
                app:tabIndicatorColor="?attr/wfmsColorPrimary"
                app:tabMode="fixed"
                app:tabSelectedTextColor="?attr/wfmsColorPrimary"
                app:tabTextColor="?attr/wfmsColorOnSurfaceVariant" />

        </com.google.android.material.appbar.AppBarLayout>

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/viewPager"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="@string/appbar_scrolling_view_behavior" />

    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</layout>