<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <import type="android.view.View" />
        <variable name="siteItem" type="com.atvantiq.wfms.models.work.workAssigned.Site" />
        <variable name="isOpenAssignment" type="Boolean" />
        <variable name="isAcceptedAssignment" type="Boolean" />
        <variable name="isWorkEnded" type="Boolean" />
        <variable name="hideButtons" type="Boolean" />
    </data>

    <!-- FIX: added app:cardBackgroundColor using androidx CardView -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/margin_small"
        android:foreground="?attr/selectableItemBackground"
        app:cardBackgroundColor="?attr/wfmsColorSurface"
        app:cardCornerRadius="@dimen/card_radius"
        app:cardElevation="@dimen/elevation_small">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/btLogedProfile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:padding="@dimen/padding">

            <!-- Site name — FIX: Dark style removed -->
            <TextView
                android:id="@+id/tvSite"
                style="@style/CustomRegularTextView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/margin_small"
                android:text="@{siteItem.name}"
                android:textColor="?attr/wfmsColorOnSurface"
                android:textStyle="bold"
                app:layout_constraintEnd_toStartOf="@+id/tvSignInStatus"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_chainStyle="packed"
                tools:text="TEST-LIVE" />

            <!-- Status chip — FIX: hardcoded green removed, binding adapter handles color -->
            <TextView
                android:id="@+id/tvSignInStatus"
                style="@style/CustomSmallTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/margin_small"
                android:background="@drawable/primary_bt_bg"
                android:paddingHorizontal="@dimen/padding_small"
                android:paddingVertical="@dimen/padding_x_small"
                android:textStyle="bold"
                app:layout_constraintEnd_toStartOf="@+id/barrier"
                app:layout_constraintStart_toEndOf="@+id/tvSite"
                app:layout_constraintTop_toTopOf="@+id/tvSite"
                assignedSiteStatus="@{siteItem.status.code}"
                tools:text="COMPLETED"
                tools:textColor="@color/status_present_text"
                tools:background="@color/status_present_bg" />

            <!-- Site ID label -->
            <TextView
                android:id="@+id/tvSiteIDLabel"
                style="@style/CustomSmallTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin"
                android:layout_marginEnd="@dimen/margin_small"
                android:text="@string/site_id"
                android:textColor="?attr/wfmsColorOnSurfaceVariant"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvSite"
                tools:text="Site ID:" />

            <!-- Site ID value — FIX: Dark style removed -->
            <TextView
                android:id="@+id/tvSiteID"
                style="@style/CustomMediumTextView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_small_extra"
                android:layout_marginEnd="@dimen/margin_small"
                android:text="@{siteItem.siteId}"
                android:textColor="?attr/wfmsColorOnSurface"
                android:textStyle="bold"
                app:layout_constraintEnd_toStartOf="@+id/barrier"
                app:layout_constraintStart_toEndOf="@+id/tvSiteIDLabel"
                app:layout_constraintTop_toTopOf="@+id/tvSiteIDLabel"
                tools:text="TEST-LIVE" />

            <!-- Project label -->
            <TextView
                android:id="@+id/tvProjectsLabel"
                style="@style/CustomSmallTextView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_small_extra"
                android:layout_marginEnd="@dimen/margin_small"
                android:text="@string/project_colon"
                android:textColor="?attr/wfmsColorOnSurfaceVariant"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvSiteID"
                tools:text="Project:" />

            <!-- Project value — FIX: Dark style removed -->
            <TextView
                android:id="@+id/tvProjects"
                style="@style/CustomMediumTextView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_small_extra"
                android:layout_marginTop="@dimen/margin_small_extra"
                android:layout_marginEnd="@dimen/margin_small"
                android:text="@{siteItem.project.name}"
                android:textColor="?attr/wfmsColorOnSurface"
                android:textStyle="bold"
                app:layout_constraintEnd_toStartOf="@+id/barrier"
                app:layout_constraintStart_toEndOf="@+id/tvProjectsLabel"
                app:layout_constraintTop_toBottomOf="@+id/tvSiteID"
                tools:text="Voult" />

            <!-- Types label -->
            <TextView
                android:id="@+id/typeLabelText"
                style="@style/CustomSmallTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_small"
                android:text="@string/types"
                android:textColor="?attr/wfmsColorOnSurfaceVariant"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvProjects" />

            <!-- Types flow chips -->
            <com.atvantiq.wfms.widgets.FlowLayout
                android:id="@+id/typeFlow"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_small_extra"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/typeLabelText"
                app:layout_constraintTop_toTopOf="@+id/typeLabelText" />

            <!-- Barrier -->
            <androidx.constraintlayout.widget.Barrier
                android:id="@+id/barrier"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:barrierDirection="start"
                app:constraint_referenced_ids="imgForwardArrow" />

            <!-- Forward arrow — FIX: added theme tint -->
            <ImageView
                android:id="@+id/imgForwardArrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_small"
                android:src="@drawable/forward_arrow_right_24"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/barrier"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="?attr/wfmsColorOnSurfaceVariant" />

            <!-- Action buttons -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin"
                android:layout_marginEnd="@dimen/margin_small"
                android:orientation="vertical"
                android:visibility="@{hideButtons ? View.GONE : View.VISIBLE}"
                app:layout_constraintEnd_toStartOf="@+id/barrier"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/typeLabelText"
                tools:visibility="gone">

                <!-- Accept — FIX: use GradientButton instead of hardcoded green -->
                <com.atvantiq.wfms.widgets.GradientButton
                    android:id="@+id/btnAccept"
                    style="@style/CustomButtonStyle"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/small_button_height"
                    android:text="@string/accept"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:visibility="@{isOpenAssignment ? View.VISIBLE : View.GONE}" />

                <!-- Start Work — FIX: use CustomPrimaryWireButton outline style -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnStartWork"
                    style="@style/CustomPrimaryWireButton"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/small_button_height"
                    android:text="@string/start_work"
                    android:textStyle="bold"
                    android:visibility="@{isAcceptedAssignment ? View.VISIBLE : View.GONE}" />

                <!-- End Work — FIX: semantic error color, not hardcoded red -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnEndWork"
                    style="@style/CustomButtonStyle"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/small_button_height"
                    android:background="@drawable/cancel_bt_bg"
                    android:text="@string/end_work"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:visibility="@{isWorkEnded ? View.VISIBLE : View.GONE}" />

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
</layout>