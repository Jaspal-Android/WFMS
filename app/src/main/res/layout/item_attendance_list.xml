<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <import type="android.view.View" />

        <variable
            name="item"
            type="com.atvantiq.wfms.models.attendance.attendanceDetails.AttendanceRecord" />
    </data>

    <androidx.cardview.widget.CardView
        android:id="@+id/cardAttendanceItem"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/margin_small"
        android:layout_marginVertical="@dimen/margin_small_extra"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        app:cardBackgroundColor="?attr/wfmsColorSurface"
        app:cardCornerRadius="@dimen/card_radius"
        app:cardElevation="0dp"
        app:cardPreventCornerOverlap="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/padding_small"
            android:layout_marginVertical="@dimen/padding_small"
            android:orientation="vertical">

            <!-- ════════════════════════════════════
                 HEADER: name + code | status
            ════════════════════════════════════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margin_small"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvEmployeeName"
                        style="@style/CustomRegularTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@{item.employee.name}"
                        android:textColor="?attr/wfmsColorOnSurface"
                        android:textStyle="bold"
                        tools:text="Jaspal Singh" />

                    <TextView
                        android:id="@+id/tvEmployeeCode"
                        style="@style/CustomSmallTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@{item.employee.code}"
                        android:textColor="?attr/wfmsColorOnSurfaceVariant"
                        tools:text="jaspal006" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tvStatus"
                    style="@style/CustomMediumTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_small"
                    android:paddingHorizontal="@dimen/padding_medium"
                    android:paddingVertical="@dimen/padding_x_small"
                    android:textStyle="bold"
                    app:attendanceStatus="@{item.status}"
                    tools:text="Present" />
            </LinearLayout>

            <!-- ════════════════════════════════════
                 META: date chip + total hours
            ════════════════════════════════════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/gark_primary_trans_bg"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/padding_small"
                    android:paddingVertical="@dimen/padding_x_small">

                    <ImageView
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:contentDescription="@string/date"
                        android:src="@drawable/ic_calendar_today"
                        app:tint="?attr/wfmsColorPrimary" />

                    <TextView
                        android:id="@+id/tvDate"
                        style="@style/CustomSmallTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/margin_small"
                        android:textColor="?attr/wfmsColorPrimary"
                        android:textStyle="bold"
                        app:formatApiDateToMonthDayYear="@{item.createdAt}"
                        tools:text="Oct 31, 2025" />

                </LinearLayout>

                <TextView
                    style="@style/CustomSmallTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_small"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:text="@{@string/total_work_hours_format(item.workHours)}"
                    android:textColor="?attr/wfmsColorPrimary"
                    android:textStyle="bold"
                    tools:text="Total 8 hrs" />
            </LinearLayout>

            <!-- ════════════════════════════════════
                 CHECK-IN / CHECK-OUT PAIR
            ════════════════════════════════════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_small"
                android:orientation="horizontal">

                <!-- Check In -->
                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:cardBackgroundColor="?attr/wfmsColorSuccessLight"
                    app:cardCornerRadius="@dimen/card_radius"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/padding_small">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:contentDescription="@string/check_in"
                                android:src="@drawable/ic_clock_16"
                                app:tint="?attr/wfmsColorSuccess" />

                            <TextView
                                style="@style/CustomSmallTextView"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/margin_small_extra"
                                android:letterSpacing="0.05"
                                android:text="@string/check_in"
                                android:textAllCaps="true"
                                android:textColor="?attr/wfmsColorSuccess"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvCheckinTime"
                            style="@style/CustomRegularTextView"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/margin_small_extra"
                            android:textColor="?attr/wfmsColorSuccess"
                            android:textStyle="bold"
                            app:formatApiDateToTime="@{item.checkin.time}"
                            tools:text="08:25 AM" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <!-- Check Out -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardCheckout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_small"
                    android:layout_weight="1"
                    app:cardBackgroundColor="?attr/wfmsColorErrorLight"
                    app:cardCornerRadius="@dimen/card_radius"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/padding_small">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:contentDescription="@string/check_out"
                                android:src="@drawable/ic_clock_16"
                                app:tint="?attr/wfmsColorError" />

                            <TextView
                                style="@style/CustomSmallTextView"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/margin_small_extra"
                                android:letterSpacing="0.05"
                                android:text="@string/check_out"
                                android:textAllCaps="true"
                                android:textColor="?attr/wfmsColorError"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvCheckoutTime"
                            style="@style/CustomRegularTextView"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/margin_small_extra"
                            android:textColor="?attr/wfmsColorError"
                            android:textStyle="bold"
                            app:formatApiDateToTime="@{item.checkout.time}"
                            tools:text="--:--" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

            </LinearLayout>

            <!-- ════════════════════════════════════
                 VIEW SITES VISITED BUTTON
            ════════════════════════════════════ -->
            <LinearLayout
                android:id="@+id/viewSitesBt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_small"
                android:background="@drawable/primary_bt_bg"
                android:clickable="true"
                android:contentDescription="@string/view_sites_visited"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center"
                android:orientation="horizontal"
                android:padding="@dimen/padding_small">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/rounded_location_on_24"
                    app:tint="@android:color/white" />

                <TextView
                    style="@style/CustomMediumLightTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_small"
                    android:text="@string/view_sites_visited"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

    </androidx.cardview.widget.CardView>
</layout>