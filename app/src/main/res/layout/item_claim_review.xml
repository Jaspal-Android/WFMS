<?xml version="1.0" encoding="utf-8"?>
<!-- A claim on the Claims Approval list: employee (or claim number), status, date, claim amount
     and Review ›. -->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="title"
            type="String" />

        <variable
            name="subtitle"
            type="String" />

        <variable
            name="status"
            type="String" />

        <variable
            name="dateLabel"
            type="String" />

        <variable
            name="amount"
            type="String" />
    </data>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_medium"
        app:cardBackgroundColor="?attr/wfmsColorSurface"
        app:cardCornerRadius="@dimen/card_radius"
        app:cardElevation="0dp"
        app:strokeColor="?attr/wfmsColorOutline"
        app:strokeWidth="@dimen/border_width_1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/padding">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="@dimen/employee_avatar_size"
                    android:layout_height="@dimen/employee_avatar_size"
                    android:background="@drawable/bg_circle_primary"
                    android:gravity="center"
                    android:importantForAccessibility="no"
                    android:textColor="@color/white"
                    android:textSize="@dimen/default_text"
                    android:textStyle="bold"
                    app:initials="@{title}"
                    tools:text="JA" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_medium"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/CustomLargeTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@{title}"
                        android:textColor="?attr/wfmsColorOnSurface"
                        android:textStyle="bold"
                        tools:text="Jaspal" />

                    <TextView
                        style="@style/CustomRegularTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@{subtitle}"
                        android:textColor="?attr/wfmsColorOnSurfaceVariant"
                        tools:text="JAXX029" />
                </LinearLayout>

                <TextView
                    style="@style/CustomRegularTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_small"
                    android:paddingStart="@dimen/padding_medium"
                    android:paddingTop="@dimen/padding_x_small"
                    android:paddingEnd="@dimen/padding_medium"
                    android:paddingBottom="@dimen/padding_x_small"
                    android:textStyle="bold"
                    app:claimStatus="@{status}"
                    tools:text="@string/submitted" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_medium"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="@dimen/icon_size_small"
                    android:layout_height="@dimen/icon_size_small"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_calendar_today"
                    app:tint="?attr/wfmsColorOnSurfaceVariant" />

                <TextView
                    style="@style/CustomRegularTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_small_extra"
                    android:text="@{dateLabel}"
                    android:textColor="?attr/wfmsColorOnSurfaceVariant"
                    tools:text="25 Sep 2026" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/reviewRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_small"
                android:background="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:minHeight="@dimen/min_touch_target"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="@dimen/icon_size_small"
                    android:layout_height="@dimen/icon_size_small"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_currency_rupee"
                    app:tint="?attr/wfmsColorPrimary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_small"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/CustomRegularTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/claim_amount"
                        android:textColor="?attr/wfmsColorOnSurfaceVariant" />

                    <TextView
                        style="@style/CustomLargeTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@{amount}"
                        android:textColor="?attr/wfmsColorOnSurface"
                        android:textStyle="bold"
                        tools:text="₹ 200.00" />
                </LinearLayout>

                <TextView
                    style="@style/CustomRegularTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/review"
                    android:textColor="?attr/wfmsColorPrimary"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="no"
                    android:src="@drawable/forward_arrow_right_24"
                    app:tint="?attr/wfmsColorPrimary" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</layout>
