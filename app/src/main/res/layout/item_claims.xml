<?xml version="1.0" encoding="utf-8"?>
<!-- An employee's claim, in two lines: claim number and claimed amount; status, date · category and
     the approved amount. Sites, expenses and type are on the claim's detail page. -->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="claimItem"
            type="com.atvantiq.wfms.models.reimbursement.allClaims.Record" />

        <!-- "Sep 29, 2026 · Local" -->
        <variable
            name="meta"
            type="String" />

        <!-- "Approved ₹ 0.00" -->
        <variable
            name="approvedLabel"
            type="String" />
    </data>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/margin_small"
        android:foreground="?attr/selectableItemBackground"
        app:cardBackgroundColor="?attr/wfmsColorSurface"
        app:cardCornerRadius="@dimen/card_radius"
        app:cardElevation="@dimen/elevation_small">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/min_touch_target"
            android:padding="@dimen/padding">

            <!-- Line 1: claim number · claimed amount -->
            <TextView
                android:id="@+id/tvClaimNumber"
                style="@style/CustomRegularTextView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/margin_small"
                android:ellipsize="middle"
                android:maxLines="1"
                android:text="@{claimItem.claimNumber}"
                android:textColor="?attr/wfmsColorOnSurface"
                android:textStyle="bold"
                app:layout_constraintEnd_toStartOf="@+id/tvAmount"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="CLM-20260929-85738A45" />

            <TextView
                android:id="@+id/tvAmount"
                style="@style/CustomRegularTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@{@string/rupee_format(claimItem.totalAmount != null ? claimItem.totalAmount : 0.0)}"
                android:textColor="?attr/wfmsColorOnSurface"
                android:textStyle="bold"
                app:layout_constraintBaseline_toBaselineOf="@id/tvClaimNumber"
                app:layout_constraintEnd_toEndOf="parent"
                tools:text="₹ 1050.00" />

            <!-- Line 2: status, date · category · approved amount -->
            <TextView
                android:id="@+id/chipStatus"
                style="@style/CustomSmallTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_small"
                android:paddingHorizontal="@dimen/padding_small"
                android:paddingVertical="@dimen/padding_x_small"
                android:textStyle="bold"
                app:claimStatus="@{claimItem.status.code}"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvClaimNumber"
                tools:text="@string/submitted" />

            <TextView
                android:id="@+id/tvMeta"
                style="@style/CustomSmallTextView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/margin_small"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@{meta}"
                android:textColor="?attr/wfmsColorOnSurfaceVariant"
                app:layout_constraintBottom_toBottomOf="@id/chipStatus"
                app:layout_constraintEnd_toStartOf="@+id/tvApproved"
                app:layout_constraintStart_toEndOf="@id/chipStatus"
                app:layout_constraintTop_toTopOf="@id/chipStatus"
                tools:text="Sep 29, 2026 · Local" />

            <!-- Approved amount: always semantic green, not theme-dependent -->
            <TextView
                android:id="@+id/tvApproved"
                style="@style/CustomSmallTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@{approvedLabel}"
                android:textColor="@color/status_present_text"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="@id/chipStatus"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/chipStatus"
                tools:text="Approved ₹ 0.00" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
</layout>
