<layout xmlns:tools="http://schemas.android.com/tools">

    <data>

        <import type="android.view.View" />

        <variable
            name="claimItem"
            type="com.atvantiq.wfms.models.reimbursement.allClaims.Record" />
    </data>

    <androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/margin_small"
        android:foreground="?attr/selectableItemBackground"
        app:cardCornerRadius="@dimen/card_radius"
        app:cardElevation="@dimen/elevation_small">


        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <!-- Claim Number -->
            <TextView
                android:id="@+id/tvClaimNumber"
                style="@style/CustomRegularDarkTextView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textStyle="bold"
                app:layout_constraintEnd_toStartOf="@id/ivCategoryIcon"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="CLM-2026-00021" />

            <!-- Category Icon (Emoji as ImageView or TextView) -->
            <TextView
                android:id="@+id/ivCategoryIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="8dp"
                android:gravity="center"
                android:textSize="20sp"
                app:layout_constraintBottom_toBottomOf="@id/tvClaimNumber"
                app:layout_constraintEnd_toStartOf="@id/ivChevron"
                app:layout_constraintTop_toTopOf="@id/tvClaimNumber"
                tools:text="📍" />

            <!-- Chevron Icon -->
            <ImageView
                android:id="@+id/ivChevron"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/forward_arrow_right_24"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/tvClaimNumber" />

            <TextView
                android:id="@+id/chipStatus"
                style="@style/CustomSmallTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_small"
                android:background="@drawable/status_green_bg"
                android:paddingHorizontal="@dimen/padding_small"
                android:paddingVertical="@dimen/padding_x_small"
                android:textColor="@color/green"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvClaimNumber"
                tools:text="Pending Accounts Approval" />


            <!-- Date Text -->
            <TextView
                android:id="@+id/tvDate"
                style="@style/CustomMediumTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_small"
                android:drawableStart="@drawable/ic_calendar_today"
                android:drawablePadding="@dimen/padding_x_small"
                android:drawableTint="@color/darkGray"
                android:gravity="center"
                app:layout_constraintBottom_toBottomOf="@id/chipStatus"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/chipStatus"
                tools:text="Jan 22, 2026" />

            <!-- Amount -->
            <TextView
                android:id="@+id/tvAmount"
                style="@style/CustomLargeDarkTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_small"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/chipStatus"
                tools:text="350.00" />

            <!-- Divider -->
            <View
                android:id="@+id/divider"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/margin"
                android:background="@color/darkGray"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvAmount" />


            <TextView
                android:id="@+id/tvSitesLabel"
                style="@style/CustomSmallTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_small"
                android:text="@string/sites"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/divider" />

            <TextView
                android:id="@+id/tvSitesCount"
                style="@style/CustomMediumDarkTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="@id/tvSitesLabel"
                app:layout_constraintTop_toBottomOf="@id/tvSitesLabel"
                tools:text="2" />


            <TextView
                android:id="@+id/tvExpensesLabel"
                style="@style/CustomSmallTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/expenses"
                app:layout_constraintEnd_toStartOf="@+id/tvTypeLabel"
                app:layout_constraintStart_toEndOf="@id/tvSitesLabel"
                app:layout_constraintTop_toTopOf="@id/tvSitesLabel" />

            <TextView
                android:id="@+id/tvExpensesCount"
                style="@style/CustomMediumDarkTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="@+id/tvExpensesLabel"
                app:layout_constraintStart_toStartOf="@id/tvExpensesLabel"
                app:layout_constraintTop_toBottomOf="@id/tvExpensesLabel"
                tools:text="3" />


            <TextView
                android:id="@+id/tvTypeLabel"
                style="@style/CustomSmallTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/type"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/tvSitesLabel" />

            <TextView
                android:id="@+id/tvTypeValue"
                style="@style/CustomMediumDarkTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="@id/tvTypeLabel"
                app:layout_constraintTop_toBottomOf="@id/tvTypeLabel"
                tools:text="Multiple" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>
</layout>