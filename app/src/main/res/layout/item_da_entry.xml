<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <import type="android.view.View" />
        <variable name="hasAttachments" type="Boolean" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/margin_small"
        android:background="@drawable/bg_item_selected"
        android:padding="@dimen/padding_small">

        <!-- Remove button — anchored first -->
        <ImageButton
            android:id="@+id/btnRemove"
            style="@style/CustomRemoveButton"
            android:contentDescription="@string/remove_entry"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Attachment icon -->
        <ImageView
            android:id="@+id/ivAttachment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/margin_small_extra"
            android:paddingHorizontal="@dimen/padding_x_small"
            android:src="@drawable/baseline_attach_file_24"
            android:visibility="@{hasAttachments ? View.VISIBLE : View.GONE}"
            app:layout_constraintBottom_toBottomOf="@+id/btnRemove"
            app:layout_constraintEnd_toStartOf="@+id/btnRemove"
            app:layout_constraintTop_toTopOf="@+id/btnRemove"
            android:contentDescription="@string/receipt_attached"
            app:tint="?attr/wfmsColorAccent" />

        <!-- Amount label -->
        <TextView
            android:id="@+id/tvAmountLabel"
            style="@style/CustomSmallTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/amount"
            android:textColor="?attr/wfmsColorOnSurfaceVariant"
            app:layout_constraintBottom_toBottomOf="@+id/btnRemove"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Amount value -->
        <TextView
            android:id="@+id/tvAmount"
            style="@style/CustomSmallTextView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_small_extra"
            android:textColor="?attr/wfmsColorOnSurface"
            android:textStyle="bold"
            app:layout_constraintBaseline_toBaselineOf="@+id/tvAmountLabel"
            app:layout_constraintEnd_toStartOf="@+id/ivAttachment"
            app:layout_constraintStart_toEndOf="@+id/tvAmountLabel"
            tools:text="₹1200" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>