<?xml version="1.0" encoding="utf-8"?>
<!-- A site on the Sites tab: name + Active chip, site ID, address, then project / circle /
     added-by tags. -->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <import type="android.view.View" />

        <variable
            name="itemSiteData"
            type="com.atvantiq.wfms.models.site.allSites.Site" />
    </data>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/margin_small"
        android:layout_marginVertical="@dimen/margin_small_extra"
        app:cardBackgroundColor="?attr/wfmsColorSurface"
        app:cardCornerRadius="@dimen/card_radius"
        app:cardElevation="0dp"
        app:strokeColor="?attr/wfmsColorOutline"
        app:strokeWidth="@dimen/border_width_1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/padding">

            <!-- Name + Active / Inactive -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:orientation="horizontal">

                <TextView
                    style="@style/CustomLargeTextView"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@{itemSiteData.name}"
                    android:textColor="?attr/wfmsColorOnSurface"
                    android:textStyle="bold"
                    tools:text="South Chandigahr" />

                <TextView
                    style="@style/CustomRegularTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_small"
                    android:paddingHorizontal="@dimen/padding_medium"
                    android:paddingVertical="@dimen/padding_x_small"
                    android:textStyle="bold"
                    app:siteActiveStatus="@{itemSiteData.isActive}"
                    tools:text="@string/site_active" />
            </LinearLayout>

            <!-- Site ID -->
            <TextView
                style="@style/CustomRegularTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_small_extra"
                android:text="@{itemSiteData.siteId}"
                android:textColor="?attr/wfmsColorOnSurfaceVariant"
                android:textStyle="bold"
                tools:text="CHD-555" />

            <!-- Address -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_small"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="@dimen/icon_size_small"
                    android:layout_height="@dimen/icon_size_small"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_pin_drop"
                    app:tint="?attr/wfmsColorOnSurfaceVariant" />

                <TextView
                    style="@style/CustomRegularTextView"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_small"
                    android:layout_weight="1"
                    android:text="@{itemSiteData.address}"
                    android:textColor="?attr/wfmsColorOnSurfaceVariant"
                    tools:text="South Chandigahr" />
            </LinearLayout>

            <!-- Project · circle · added by -->
            <com.google.android.flexbox.FlexboxLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_small_extra"
                app:flexWrap="wrap">

                <TextView
                    style="@style/CustomTagChip.Info"
                    android:text="@{itemSiteData.project.name}"
                    android:visibility="@{itemSiteData.project.name == null ? View.GONE : View.VISIBLE}"
                    tools:text="shivam testing project" />

                <TextView
                    style="@style/CustomTagChip"
                    android:text="@{itemSiteData.circle.name}"
                    android:visibility="@{itemSiteData.circle.name == null ? View.GONE : View.VISIBLE}"
                    tools:text="Chandigarh" />

                <TextView
                    style="@style/CustomTagChip"
                    android:text="@{itemSiteData.addedBy.name}"
                    android:visibility="@{itemSiteData.addedBy.name == null ? View.GONE : View.VISIBLE}"
                    tools:text="Admin3" />
            </com.google.android.flexbox.FlexboxLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</layout>
