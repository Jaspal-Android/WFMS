<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="addedDate"
            type="String" />

        <variable
            name="itemSiteData"
            type="com.atvantiq.wfms.models.site.allSites.Site" />
    </data>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/margin_small"
        android:layout_marginVertical="@dimen/margin_small_extra"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        app:cardBackgroundColor="?attr/wfmsColorSurface"
        app:cardCornerRadius="@dimen/card_radius"
        app:cardElevation="0dp"
        app:cardPreventCornerOverlap="true"
        app:strokeColor="?attr/wfmsColorOutline"
        app:strokeWidth="@dimen/border_width_1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/padding_medium">

            <!-- ════════════════════════════════════
                 HEADER ROW: icon | name + id + address | date
            ════════════════════════════════════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- Leading site icon -->
                <androidx.cardview.widget.CardView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="?attr/wfmsCard1Color"
                    app:cardCornerRadius="@dimen/card_radius_small"
                    app:cardElevation="0dp">

                    <ImageView
                        android:layout_margin="@dimen/padding_small"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:contentDescription="@string/site"
                        android:src="@drawable/ic_marker_on_24"
                        app:tint="@android:color/white" />
                </androidx.cardview.widget.CardView>

                <!-- Name + ID + Address stack -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_small"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <!-- Name + ID badge -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvSiteName"
                            style="@style/CustomMediumTextView"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@{itemSiteData.name}"
                            android:textColor="?attr/wfmsColorOnSurface"
                            android:textStyle="bold"
                            tools:text="Tower BTS-04 Mohali Phase-7" />

                        <TextView
                            android:id="@+id/tvSiteId"
                            style="@style/CustomSmallTextView"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/margin_small"
                            android:background="@drawable/info_chip_bg"
                            android:paddingHorizontal="@dimen/padding_small"
                            android:paddingVertical="2dp"
                            android:text="@{itemSiteData.siteId}"
                            android:textColor="?attr/wfmsColorPrimary"
                            android:textStyle="bold"
                            tools:text="JIOPB003" />
                    </LinearLayout>

                    <!-- Address -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_small_extra"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:layout_marginTop="2dp"
                            android:contentDescription="@string/Address"
                            android:src="@drawable/rounded_location_on_24"
                            app:tint="?attr/wfmsColorOnSurfaceVariant" />

                        <TextView
                            android:id="@+id/tvSiteAddress"
                            style="@style/CustomSmallTextView"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/margin_small_extra"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:text="@{itemSiteData.address}"
                            android:textColor="?attr/wfmsColorOnSurfaceVariant"
                            tools:text="Phase 7, Industrial Area, Sector 73, Mohali, Punjab 160071" />
                    </LinearLayout>

                </LinearLayout>

                <!-- Added date -->
                <TextView
                    android:id="@+id/tvCreatedDate"
                    style="@style/CustomSmallTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_small"
                    android:text="@{addedDate}"
                    android:textColor="?attr/wfmsColorOnSurfaceVariant"
                    tools:text="Nov 1, 2025" />

            </LinearLayout>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/border_width_1dp"
                android:layout_marginVertical="@dimen/margin_small"
                android:background="?attr/wfmsColorOutline" />

            <!-- ════════════════════════════════════
                 META ROW: Circle | Project
            ════════════════════════════════════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- Circle -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/margin_small"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/CustomSmallTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/margin_small_extra"
                        android:text="@string/circle"
                        android:textAllCaps="true"
                        android:textColor="?attr/wfmsColorOnSurfaceVariant" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:background="@drawable/chip_bg"
                            android:id="@+id/tvCircleCode"
                            style="@style/CustomSmallLightTextView"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/margin_small_extra"
                            android:paddingHorizontal="@dimen/padding_small"
                            android:paddingVertical="2dp"
                            android:text="@{itemSiteData.circle.code}"
                            android:textStyle="bold"
                            tools:text="PB" />

                        <TextView
                            android:id="@+id/tvCircleName"
                            style="@style/CustomMediumTextView"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@{itemSiteData.circle.name}"
                            android:textColor="?attr/wfmsColorOnSurface"
                            tools:text="Punjab" />
                    </LinearLayout>

                </LinearLayout>

                <!-- Project -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/CustomSmallTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/margin_small_extra"
                        android:text="@string/project"
                        android:textAllCaps="true"
                        android:textColor="?attr/wfmsColorOnSurfaceVariant" />

                    <TextView
                        android:id="@+id/tvProjectName"
                        style="@style/CustomMediumTextView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:text="@{itemSiteData.project.name}"
                        android:textColor="?attr/wfmsColorOnSurface"
                        tools:text="Project Alpha — North Region Rollout" />
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </androidx.cardview.widget.CardView>
</layout>