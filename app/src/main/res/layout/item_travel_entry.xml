<?xml version="1.0" encoding="utf-8"?>
<layout>
    <data>
        <import type="android.view.View"></import>
        <variable
            name="hasAttachments"
            type="Boolean" />
    </data>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/margin_small"
    android:background="@drawable/bg_item_selected"
    android:padding="@dimen/padding_small">

    <TextView
        style="@style/CustomSmallDarkTextView"
        android:id="@+id/tvEntryNumber"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Entry 1"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/btnRemove"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_close_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Center anchor -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineCenter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.5" />

    <TextView
        style="@style/CustomMediumTextView"
        android:id="@+id/tvModeLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Mode:"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvEntryNumber" />

    <TextView
        style="@style/CustomMediumDarkTextView"
        android:id="@+id/tvMode"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:text="Bus"
        app:layout_constraintStart_toEndOf="@id/tvModeLabel"
        app:layout_constraintEnd_toStartOf="@id/barrier"
        app:layout_constraintTop_toTopOf="@id/tvModeLabel" />

    <TextView
        style="@style/CustomMediumTextView"
        android:id="@+id/tvAmountLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Amount:"
        app:layout_constraintStart_toEndOf="@id/barrier"
        app:layout_constraintTop_toTopOf="@id/tvModeLabel" />

    <TextView
        android:id="@+id/tvAmount"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:text="₹500"
        style="@style/CustomMediumDarkTextView"
        app:layout_constraintStart_toEndOf="@id/tvAmountLabel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tvAmountLabel" />

    <TextView
        android:id="@+id/tvRouteLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Route:"
        style="@style/CustomMediumTextView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvMode" />

    <TextView
        android:id="@+id/tvRoute"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:text="Mumbai → Pune"
        style="@style/CustomMediumDarkTextView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/tvRouteLabel"
        app:layout_constraintTop_toTopOf="@id/tvRouteLabel" />

    <TextView
        android:id="@+id/tvWithLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="With:"
        style="@style/CustomMediumTextView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvRouteLabel" />

    <TextView
        android:id="@+id/tvWith"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        style="@style/CustomMediumDarkTextView"
        app:layout_constraintStart_toEndOf="@id/tvWithLabel"
        app:layout_constraintTop_toTopOf="@id/tvWithLabel" />

    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="start"
        app:barrierAllowsGoneWidgets="true"
        app:constraint_referenced_ids="guidelineCenter" />

    <ImageView
        android:paddingEnd="@dimen/padding_x_small"
        android:paddingStart="@dimen/padding"
        android:visibility="@{hasAttachments? View.VISIBLE : View.GONE}"
        android:id="@+id/ivAttachment"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:tint="@color/colorPrimaryDark"
        android:src="@drawable/baseline_attach_file_24"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginEnd="@dimen/margin_small"
        app:layout_constraintEnd_toStartOf="@+id/btnRemove"
        />

</androidx.constraintlayout.widget.ConstraintLayout>
</layout>