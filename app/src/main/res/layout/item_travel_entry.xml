<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <import type="android.view.View" />

        <variable
            name="hasAttachments"
            type="Boolean" />

        <variable
            name="isTravelingWith"
            type="Boolean" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/margin_small"
        android:padding="@dimen/padding_small"
        android:background="@drawable/bg_item_selected"
        >

        <TextView
            android:id="@+id/tvEntryNumber"
            style="@style/CustomSmallTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/primary_bt_bg"
            android:paddingHorizontal="@dimen/padding_small"
            android:paddingVertical="@dimen/padding_x_small"
            android:textColor="@color/white"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Entry 1" />

        <!-- Attachment icon — FIX: ?attr/colorPrimaryDark → wfmsColorPrimary -->
        <ImageView
            android:id="@+id/ivAttachment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/margin_small"
            android:paddingStart="@dimen/padding_x_small"
            android:paddingEnd="@dimen/padding_x_small"
            android:src="@drawable/baseline_attach_file_24"
            android:visibility="@{hasAttachments ? View.VISIBLE : View.GONE}"
            app:layout_constraintBottom_toBottomOf="@+id/tvEntryNumber"
            app:layout_constraintEnd_toStartOf="@+id/btnRemove"
            app:layout_constraintTop_toTopOf="@+id/tvEntryNumber"
            app:tint="?attr/wfmsColorPrimary" />

        <!-- Remove button — FIX: surfaceVariant circle bg + onSurfaceVariant tint -->
        <ImageButton
            android:id="@+id/btnRemove"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/ic_circular_bg"
            android:src="@drawable/ic_close_16"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="?attr/wfmsColorPrimaryLight" />

        <!-- ── Divider below header ── -->
        <View
            android:id="@+id/dividerHeader"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginTop="@dimen/margin_small"
            android:alpha="0.1"
            android:background="?attr/wfmsColorOnSurface"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvEntryNumber" />

        <!-- ── Mode + Amount 2-column grid ── -->
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guidelineCenter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.5" />

        <!-- Mode chip -->
        <LinearLayout
            android:id="@+id/chipMode"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_small"
            android:layout_marginEnd="@dimen/margin_small_extra"
            android:background="@drawable/info_chip_bg"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/padding_small"
            android:paddingVertical="@dimen/padding_x_small"
            app:layout_constraintEnd_toStartOf="@+id/guidelineCenter"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/dividerHeader">

            <TextView
                style="@style/CustomSmallTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mode"
                android:textAllCaps="true"
                android:textColor="?attr/wfmsColorOnSurfaceVariant" />

            <TextView
                android:id="@+id/tvMode"
                style="@style/CustomSmallTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?attr/wfmsColorOnSurface"
                android:textStyle="bold"
                tools:text="Bus" />
        </LinearLayout>

        <!-- Amount chip -->
        <LinearLayout
            android:id="@+id/chipAmount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_small_extra"
            android:layout_marginTop="@dimen/margin_small"
            android:background="@drawable/info_chip_bg"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/padding_small"
            android:paddingVertical="@dimen/padding_x_small"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/guidelineCenter"
            app:layout_constraintTop_toBottomOf="@+id/dividerHeader">

            <TextView
                style="@style/CustomSmallTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/amount"
                android:textAllCaps="true"
                android:textColor="?attr/wfmsColorOnSurfaceVariant" />

            <TextView
                android:id="@+id/tvAmount"
                style="@style/CustomSmallTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?attr/wfmsColorOnSurface"
                android:textStyle="bold"
                tools:text="₹500" />
        </LinearLayout>

        <!-- ── Route row ── -->
        <TextView
            android:id="@+id/tvRouteLabel"
            style="@style/CustomSmallTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_small"
            android:text="@string/route"
            android:textColor="?attr/wfmsColorOnSurfaceVariant"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/chipMode" />

        <TextView
            android:id="@+id/tvRoute"
            style="@style/CustomSmallTextView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_small_extra"
            android:textColor="?attr/wfmsColorOnSurface"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tvRouteLabel"
            app:layout_constraintTop_toTopOf="@+id/tvRouteLabel"
            tools:text="Mumbai → Pune" />

        <!-- ── Traveling With row (conditional) ── -->
        <TextView
            android:id="@+id/tvWithLabel"
            style="@style/CustomSmallTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_small_extra"
            android:text="@string/with"
            android:textColor="?attr/wfmsColorOnSurfaceVariant"
            android:visibility="@{isTravelingWith ? View.VISIBLE : View.GONE}"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvRouteLabel" />

        <TextView
            android:id="@+id/tvWith"
            style="@style/CustomSmallTextView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_small_extra"
            android:textColor="?attr/wfmsColorOnSurface"
            android:textStyle="bold"
            android:visibility="@{isTravelingWith ? View.VISIBLE : View.GONE}"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tvWithLabel"
            app:layout_constraintTop_toTopOf="@+id/tvWithLabel"
            tools:text="Jaspal" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>