<?xml version="1.0" encoding="utf-8"?>
<!-- A site on Work Sites: the site summary, then Review site details ›. -->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable
            name="item"
            type="com.atvantiq.wfms.models.workSites.workSites.WorkSite" />
    </data>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_medium"
        app:cardBackgroundColor="?attr/wfmsColorSurface"
        app:cardCornerRadius="@dimen/card_radius"
        app:cardElevation="0dp"
        app:strokeColor="?attr/wfmsColorOutline"
        app:strokeWidth="@dimen/border_width_1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/padding">

            <include
                layout="@layout/layout_site_summary"
                app:circle="@{item.circle.name}"
                app:project="@{item.project.name}"
                app:siteId="@{item.site.siteId}"
                app:siteName="@{item.site.name}"
                app:statusCode="@{item.status.code}"
                app:statusLabel="@{item.status.label}" />

            <LinearLayout
                android:id="@+id/reviewRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_small"
                android:background="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:minHeight="@dimen/min_touch_target"
                android:orientation="horizontal">

                <TextView
                    style="@style/CustomRegularTextView"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/review_site_details"
                    android:textColor="?attr/wfmsColorAccent"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="no"
                    android:src="@drawable/forward_arrow_right_24"
                    app:tint="?attr/wfmsColorAccent" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</layout>
