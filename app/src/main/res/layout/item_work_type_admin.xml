<?xml version="1.0" encoding="utf-8"?>
<!-- A work type on Site Work Detail: checkbox and name, the status and PM / OPS / ADMIN step tags,
     and the started date. A type this role can't act on is shown dimmed. -->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="item"
            type="com.atvantiq.wfms.models.workSites.workSiteDetails.WorkType" />

        <variable
            name="startedLabel"
            type="String" />
    </data>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_medium"
        app:cardBackgroundColor="?attr/wfmsColorSurface"
        app:cardCornerRadius="@dimen/card_radius"
        app:cardElevation="0dp"
        app:strokeColor="?attr/wfmsColorOutline"
        app:strokeWidth="@dimen/border_width_1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="@dimen/padding_small">

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cbWorkType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@{item.name}"
                app:buttonTint="?attr/wfmsColorPrimary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingTop="@dimen/padding_small"
                android:paddingEnd="@dimen/padding_small"
                android:paddingBottom="@dimen/padding_small">

                <TextView
                    style="@style/CustomLargeTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@{item.name ?? @string/not_available_value}"
                    android:textColor="?attr/wfmsColorOnSurface"
                    android:textStyle="bold"
                    tools:text="I&amp;C,Integration" />

                <com.google.android.flexbox.FlexboxLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:flexWrap="wrap">

                    <TextView
                        style="@style/CustomTagChip"
                        android:text="@{item.status.label ?? @string/not_available_value}"
                        tools:text="WIP" />

                    <TextView
                        style="@style/CustomStatusChip"
                        app:approvalStep="@{item.pm.status}"
                        app:approvalStepLabel="@{@string/approver_pm}"
                        tools:text="PM: 0" />

                    <TextView
                        style="@style/CustomStatusChip"
                        app:approvalStep="@{item.ops.status}"
                        app:approvalStepLabel="@{@string/approver_ops}"
                        tools:text="OPS: 0" />

                    <TextView
                        style="@style/CustomStatusChip"
                        app:approvalStep="@{item.admin.status}"
                        app:approvalStepLabel="@{@string/approver_admin}"
                        tools:text="ADMIN: 0" />
                </com.google.android.flexbox.FlexboxLayout>

                <TextView
                    style="@style/CustomRegularTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_small"
                    android:text="@{startedLabel ?? @string/not_available_value}"
                    android:textColor="?attr/wfmsColorOnSurfaceVariant"
                    tools:text="1 Oct 2026" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</layout>
