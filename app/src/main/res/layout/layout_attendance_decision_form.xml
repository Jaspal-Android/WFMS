<?xml version="1.0" encoding="utf-8"?>
<!-- The Attendance Decision form: the 8-status grid and the approval remarks. Shared by the
     Attendance Decision sheet and the Attendance Review screen. -->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable
            name="vm"
            type="com.atvantiq.wfms.ui.screens.admin.ui.attendanceApproval.AttendanceApprovalVM" />
    </data>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="?attr/wfmsColorSurface"
        app:cardCornerRadius="@dimen/card_radius"
        app:cardElevation="0dp"
        app:strokeColor="?attr/wfmsColorOutline"
        app:strokeWidth="@dimen/border_width_1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/padding">

            <TextView
                style="@style/CustomLargeTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/attendance_decision"
                android:textColor="?attr/wfmsColorOnSurface"
                android:textStyle="bold" />

            <TextView
                style="@style/CustomMoreRowSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_small"
                android:text="@string/attendance_decision_help" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/statusGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_small"
                android:nestedScrollingEnabled="false"
                app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                app:spanCount="2" />

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/border_width_1dp"
                android:layout_marginVertical="@dimen/margin_medium"
                android:background="?attr/wfmsColorOutline" />

            <TextView
                style="@style/CustomRegularTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/approval_remarks"
                android:textColor="?attr/wfmsColorOnSurfaceVariant"
                android:textStyle="bold" />

            <TextView
                style="@style/CustomMoreRowSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_small"
                android:text="@string/approval_remarks_help" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/CustomOutlinedField"
                android:hint="@string/approval_remarks">

                <com.google.android.material.textfield.TextInputEditText
                    style="@style/CustomEditInputTextRegularStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top|start"
                    android:inputType="textMultiLine|textCapSentences"
                    android:minLines="3"
                    android:text="@={vm.decisionRemarks}" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</layout>
