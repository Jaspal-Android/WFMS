<?xml version="1.0" encoding="utf-8"?>
<!-- An approval category on the Approvals hub: icon box, title, subtitle, a status tag under them
     and a chevron. -->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="icon"
            type="android.graphics.drawable.Drawable" />
        <variable
            name="title"
            type="String" />
        <variable
            name="subtitle"
            type="String" />
        <variable
            name="badge"
            type="String" />
        <variable
            name="onClick"
            type="android.view.View.OnClickListener" />
    </data>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/margin_medium"
        android:onClick="@{onClick}"
        app:cardBackgroundColor="?attr/wfmsColorSurface"
        app:cardCornerRadius="@dimen/card_radius"
        app:cardElevation="0dp"
        app:strokeColor="?attr/wfmsColorOutline"
        app:strokeWidth="@dimen/border_width_1dp">

        <LinearLayout
            style="@style/CustomMoreRow">

            <ImageView
                style="@style/CustomMoreRowIcon"
                android:background="@drawable/info_chip_bg"
                android:importantForAccessibility="no"
                android:src="@{icon}"
                app:tint="?attr/wfmsColorPrimary"
                tools:src="@drawable/ic_tab_approvals" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/CustomLargeTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@{title}"
                    android:textColor="?attr/wfmsColorOnSurface"
                    android:textStyle="bold"
                    tools:text="@string/work_approval" />

                <TextView
                    style="@style/CustomMoreRowSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_small_extra"
                    android:text="@{subtitle}"
                    tools:text="@string/work_approval_subtitle" />

                <TextView
                    style="@style/CustomTagChip.Success"
                    android:text="@{badge}"
                    tools:text="@string/available" />
            </LinearLayout>

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:importantForAccessibility="no"
                android:src="@drawable/forward_arrow_right_24"
                app:tint="?attr/wfmsColorOnSurfaceVariant" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</layout>
