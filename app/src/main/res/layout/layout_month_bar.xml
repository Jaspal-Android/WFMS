<?xml version="1.0" encoding="utf-8"?>
<!-- ‹ Month · count › on one line: the slim version of layout_month_header (same variables), for
     screens where the list matters more than the month, such as Claims. -->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <import type="android.view.View" />

        <variable
            name="title"
            type="String" />
        <variable
            name="subtitle"
            type="String" />
        <variable
            name="onPrevious"
            type="android.view.View.OnClickListener" />
        <variable
            name="onNext"
            type="android.view.View.OnClickListener" />
    </data>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="?attr/wfmsColorSurface"
        app:cardCornerRadius="@dimen/card_radius"
        app:cardElevation="0dp"
        app:strokeColor="?attr/wfmsColorOutline"
        app:strokeWidth="@dimen/border_width_1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/min_touch_target"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                style="@style/CustomIconButton.Small"
                android:contentDescription="@string/previous_month"
                android:onClick="@{onPrevious}"
                android:src="@drawable/arrow_back_ios_24"
                app:tint="?attr/wfmsColorAccent" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    style="@style/CustomLargeTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:text="@{title}"
                    android:textColor="?attr/wfmsColorOnSurface"
                    android:textStyle="bold"
                    tools:text="September 2026" />

                <TextView
                    style="@style/CustomRegularTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_small_extra"
                    android:maxLines="1"
                    android:text="@{@string/month_bar_count_format(subtitle)}"
                    android:textColor="?attr/wfmsColorOnSurfaceVariant"
                    android:visibility="@{subtitle == null ? View.GONE : View.VISIBLE}"
                    tools:text="· 1 claim" />
            </LinearLayout>

            <ImageButton
                style="@style/CustomIconButton.Small"
                android:contentDescription="@string/next_month"
                android:onClick="@{onNext}"
                android:src="@drawable/arrow_forward_ios_24"
                app:tint="?attr/wfmsColorAccent" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</layout>
