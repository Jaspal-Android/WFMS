<resources>

    <!--
        values-night/themes.xml
        ══════════════════════════════════════════════════════════════
        Dark mode overrides for all 6 WFMS theme overlays.

        KEY CHANGE from previous version:
        - wfmsColorPrimary stays the SAME as light mode (rich brand color)
        - wfmsColorGradientEnd stays the SAME — gradient looks correct
        - Only bg/surface/text colors switch to dark palette
        - This matches the web admin panel dark mode behavior
    ══════════════════════════════════════════════════════════════ -->

    <!-- ── FOREST GREEN — Dark ── -->
    <style name="ThemeOverlay.WFMS.Forest" parent="Theme.WFMS">
        <!-- Keep SAME primary as light mode -->
        <item name="wfmsColorPrimary">@color/forest_primary</item>
        <item name="wfmsColorPrimaryDark">@color/forest_primary_dark</item>
        <item name="wfmsColorPrimaryLight">@color/forest_primary_light</item>
        <item name="wfmsColorGradientEnd">@color/forest_gradient_end</item>
        <item name="wfmsColorCta">@color/forest_cta</item>
        <!-- Dark surfaces -->
        <item name="wfmsColorBackground">@color/dark_bg</item>
        <item name="wfmsColorSurface">@color/dark_surface</item>
        <item name="wfmsColorSurfaceVariant">@color/dark_surface_variant</item>
        <item name="wfmsColorOnSurface">@color/dark_on_surface</item>
        <item name="wfmsColorOnSurfaceVariant">@color/dark_on_surface_variant</item>
        <item name="wfmsColorOutline">@color/dark_outline</item>
        <item name="wfmsColorSuccess">@color/forest_success</item>
        <item name="wfmsColorSuccessLight">@color/dark_surface_2</item>
        <item name="wfmsColorWarning">@color/forest_warning</item>
        <item name="wfmsColorWarningLight">@color/dark_surface_2</item>
        <item name="wfmsColorError">@color/forest_error</item>
        <item name="wfmsColorErrorLight">@color/dark_surface_2</item>
        <item name="wfmsCard1Color">@color/forest_card1_color</item>
        <item name="wfmsCard2Color">@color/forest_card2_color</item>
        <item name="wfmsCard3Color">@color/forest_card3_color</item>
        <item name="wfmsCard4Color">@color/forest_card4_color</item>
        <!-- Material3 roles -->
        <item name="colorPrimary">@color/forest_primary</item>
        <item name="colorSecondary">@color/forest_cta</item>
        <item name="colorSurface">@color/dark_surface</item>
        <item name="colorError">@color/forest_error</item>
        <item name="android:colorBackground">@color/dark_bg</item>
        <item name="android:windowBackground">@color/dark_bg</item>
        <item name="android:statusBarColor">@color/forest_primary_dark</item>
    </style>

