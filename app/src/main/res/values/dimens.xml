    <!--TextInputEditText min height-->
    <dimen name="text_input_edit_text_min_height">40dp</dimen>

    <dimen name="nav_header_height">176dp</dimen>

    <!-- Minimum recommended tap target (Material / WCAG 2.5.8). -->
    <dimen name="min_touch_target">48dp</dimen>
    <!-- Profile initials avatar: More card and My Profile header -->
    <dimen name="avatar_size">64dp</dimen>
