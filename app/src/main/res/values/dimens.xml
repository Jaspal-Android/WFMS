    <dimen name="icon_size_small">20dp</dimen>
    <dimen name="icon_touch_inset_small">14dp</dimen>
    <dimen name="switch_button_height">@dimen/min_touch_target</dimen>

    <!--padding-->
    <dimen name="button_padding_lr">16dp</dimen>
    <dimen name="button_padding_tb">8dp</dimen>
    <dimen name="padding">16dp</dimen>
    <dimen name="padding_large">20dp</dimen>
    <dimen name="padding_medium">12dp</dimen>
    <dimen name="padding_small">8dp</dimen>
    <dimen name="padding_x_small">4dp</dimen>


    <!--text size-->
    <dimen name="default_small_text">10sp</dimen>
    <dimen name="default_medium_small_text">12sp</dimen>
    <dimen name="default_text">13sp</dimen>
    <dimen name="default_large_text">18sp</dimen>
    <dimen name="default_extra_big_text">24sp</dimen>


    <!--redius-->
    <!-- The one corner radius for cards, buttons, inputs, search fields, dialogs and sheets. -->
    <dimen name="card_radius">12dp</dimen>
    <!-- Fully rounded ends for chips, status badges and progress tracks (clamped to half the height). -->
    <dimen name="radius_pill">999dp</dimen>
