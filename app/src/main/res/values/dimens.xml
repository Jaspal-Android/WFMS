    <dimen name="splash_logo_radius">28dp</dimen>

    <!--elevation-->
    <dimen name="elevation">4dp</dimen>
    <dimen name="elevation_small">2dp</dimen>

    <!--margins-->
    <dimen name="margin_small_extra">4dp</dimen>
    <dimen name="margin_small">8dp</dimen>
    <dimen name="margin">16dp</dimen>
    <dimen name="margin_medium">12dp</dimen>
    <dimen name="margin_large">18dp</dimen>
    <dimen name="margin_big">24dp</dimen>
    <dimen name="margin_x_large">32dp</dimen>
    <dimen name="margin_huge">42dp</dimen>
    <dimen name="margin_2dp">2dp</dimen>







    <!--Extra-->
    <dimen name="item_category_small">75dp</dimen>
    <dimen name="border_width_1dp">1dp</dimen>
    <dimen name="border_width_2dp">2dp</dimen>


    <!-- Lottie "no data" animation shown by empty lists -->
    <dimen name="empty_state_animation_size">150dp</dimen>
    <!-- Header of a screen opened from a tab: round back button, centred title -->
    <dimen name="screen_header_height">64dp</dimen>
    <dimen name="screen_header_back_size">@dimen/min_touch_target</dimen>
    <dimen name="screen_header_title_inset">72dp</dimen>
    <!-- Opacity of a row that can't be acted on (Material's disabled emphasis) -->
    <item name="alpha_enabled" format="float" type="dimen">1.0</item>
    <item name="alpha_disabled" format="float" type="dimen">0.38</item>
    <!-- A work type this role can't act on, on Site Work Detail (spec 7.3) -->
    <item name="alpha_ineligible" format="float" type="dimen">0.7</item>
    <!-- Initials avatar on an employee-day row (approvals) -->
    <dimen name="employee_avatar_size">40dp</dimen>
    <!-- Icon over an approval list's empty-state text -->
    <dimen name="empty_state_icon_size">36dp</dimen>
</resources>