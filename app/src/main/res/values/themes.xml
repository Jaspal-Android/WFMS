<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- ══════════════════════════════════════════════════════════════
         BASE APPLICATION THEME
         Parent: Material3 DayNight (handles system dark mode too)
    ══════════════════════════════════════════════════════════════ -->
    <style name="Base.Theme.WFMS" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="fontFamily">@font/roboto_regular</item>
        <item name="android:windowBackground">?attr/wfmsColorBackground</item>

        <!-- Provide default values for WFMS custom attributes (Forest palette) -->
        <item name="wfmsColorPrimary">@color/forest_primary</item>
        <item name="wfmsColorPrimaryDark">@color/forest_primary_dark</item>
        <item name="wfmsColorPrimaryLight">@color/forest_primary_light</item>
        <item name="wfmsColorAccent">@color/forest_primary</item>
        <item name="wfmsColorCta">@color/forest_cta</item>
        <item name="wfmsColorBackground">@color/forest_bg</item>
        <item name="wfmsColorSurface">@color/forest_surface</item>
        <item name="wfmsColorSurfaceVariant">@color/forest_surface_variant</item>
        <item name="wfmsColorOnSurface">@color/forest_on_surface</item>
        <item name="wfmsColorOnSurfaceVariant">@color/forest_on_surface_variant</item>
        <item name="wfmsColorOutline">@color/forest_outline</item>
        <item name="wfmsColorSuccess">@color/forest_success</item>
        <item name="wfmsColorSuccessLight">@color/forest_success_light</item>
        <item name="wfmsColorWarning">@color/forest_warning</item>
        <item name="wfmsColorWarningLight">@color/forest_warning_light</item>
        <item name="wfmsColorError">@color/forest_error</item>
        <item name="wfmsColorErrorLight">@color/forest_error_light</item>
        <item name="wfmsCard1Color">@color/forest_card1_color</item>
        <item name="wfmsCard2Color">@color/forest_card2_color</item>
        <item name="wfmsCard3Color">@color/forest_card3_color</item>
        <item name="wfmsCard4Color">@color/forest_card4_color</item>
        <item name="wfmsColorGradientEnd">@color/forest_gradient_end</item>

        <!-- Wire Material3 color roles to our custom attributes -->
        <item name="colorPrimary">?attr/wfmsColorPrimary</item>
        <item name="colorPrimaryVariant">?attr/wfmsColorPrimaryDark</item>
        <item name="colorSecondary">?attr/wfmsColorCta</item>
        <!-- Foreground accent for dialog buttons, cursors and controls (light mode: the brand color) -->
        <item name="colorAccent">?attr/wfmsColorAccent</item>
        <item name="android:colorAccent">?attr/wfmsColorAccent</item>
        <item name="colorControlActivated">?attr/wfmsColorAccent</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.WFMS.MaterialAlertDialog</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.WFMS.AlertDialog</item>
        <item name="colorSurface">?attr/wfmsColorSurface</item>
        <item name="colorError">?attr/wfmsColorError</item>
        <item name="android:colorBackground">?attr/wfmsColorBackground</item>
        <item name="android:textColorPrimary">?attr/wfmsColorOnSurface</item>
        <item name="android:textColorSecondary">?attr/wfmsColorOnSurfaceVariant</item>
        <item name="android:statusBarColor">@color/forest_primary_dark</item>

        <!-- One corner radius for every Material component (cards, text fields, dialogs, menus,
             sheets). Fully rounded components (chips, FABs) keep shapeAppearanceCornerFull. -->
        <item name="shapeAppearanceCornerExtraSmall">@style/ShapeAppearance.WFMS.Standard</item>
        <item name="shapeAppearanceCornerSmall">@style/ShapeAppearance.WFMS.Standard</item>
        <item name="shapeAppearanceCornerMedium">@style/ShapeAppearance.WFMS.Standard</item>
        <item name="shapeAppearanceCornerLarge">@style/ShapeAppearance.WFMS.Standard</item>
        <item name="shapeAppearanceCornerExtraLarge">@style/ShapeAppearance.WFMS.Standard</item>

    </style>

    <style name="ShapeAppearance.WFMS.Standard" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/card_radius</item>
    </style>

    <style name="Theme.WFMS" parent="Base.Theme.WFMS" />

    <!-- Dialog buttons read colorPrimary; point them at the accent so they stay readable in dark
         mode. One overlay per dialog family: MaterialAlertDialogBuilder and AlertDialog.Builder. -->
    <style name="ThemeOverlay.WFMS.MaterialAlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorPrimary">?attr/wfmsColorAccent</item>
    </style>

    <style name="ThemeOverlay.WFMS.AlertDialog" parent="ThemeOverlay.Material3.Dialog.Alert">
        <item name="colorPrimary">?attr/wfmsColorAccent</item>
    </style>

    <style name="Theme.WFMS.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.WFMS.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />
    <style name="Theme.WFMS.PopupOverlay"  parent="ThemeOverlay.AppCompat.Light" />


