<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
        Cleartext (HTTP) traffic is denied app-wide. All API flavors (dev/beta/demo/prod)
        use HTTPS base URLs, so no host needs a cleartext exception. This prevents auth
        tokens and location data from ever being sent over an unencrypted connection.
    -->
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
