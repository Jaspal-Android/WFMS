# Copy this file to secrets.properties (it is git-ignored) and fill in the real value.
# CI does not read this file: it passes the same names as environment variables.
#
# Required for release builds; debug builds work without it (maps just will not render).
# Restrict the key in the Google Cloud console to this app's package names and signing SHA-1s.
GOOGLE_MAPS_API_KEY=your-maps-api-key
